# Copy to .dev.vars (git-ignored) for local Guestbook development.
# Create a GitHub OAuth app with callback http://localhost:4321/api/guestbook/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# At least 32 random characters: `openssl rand -base64 48`
SESSION_SECRET=
# Your numeric GitHub user id: `gh api user --jq .id`
OWNER_GITHUB_ID=
# Cloudflare deploy hook that rebuilds the site after a note is approved
DEPLOY_HOOK_URL=
