---
// Self-hosted variable fonts (served from our own domain; unicode-range keeps
// non-Latin subsets from downloading unless a page needs them).
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
	title?: string;
	description?: string;
	/** Which primary nav item is current (path like "/work"). */
	current?: string;
	/** Hide the "Get in touch" button in the header (Contact page). */
	hideCta?: boolean;
	footer?: 'full' | 'simple' | 'contact';
}

const {
	title = SITE.title,
	description = SITE.description,
	current = '/',
	hideCta = false,
	footer = 'simple',
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{canonical && <link rel="canonical" href={canonical} />}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#08090A" />
		<link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
	</head>
	<body>
		<Header current={current} hideCta={hideCta} />
		<slot />
		<Footer variant={footer} />
	</body>
</html>
