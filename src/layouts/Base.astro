---
// Self-hosted variable fonts (served from our own domain; unicode-range keeps
// non-Latin subsets from downloading unless a page needs them).
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/instrument-serif/latin-400-italic.css';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandMenu from '../components/CommandMenu.astro';
import { SITE } from '../data/site';

interface Props {
	title?: string;
	description?: string;
	/** Nav item to mark as current (path like "/work"). */
	current?: string;
	/** Home uses a taller backdrop and the short footer. */
	home?: boolean;
}

const { title = SITE.title, description = SITE.description, current = '', home = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{canonical && <link rel="canonical" href={canonical} />}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#08090A" />
		<link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
		<slot name="head" />
	</head>
	<body>
		<div class:list={['v2spot', { home }]} aria-hidden="true"><div class="grain"></div><div class="spot"></div></div>
		<Header current={current} home={home} />
		<main class="col" id="top" style="position: relative">
			<slot />
		</main>
		<Footer home={home} />
		<CommandMenu />
	</body>
</html>
