---
/**
 * Container — the single content column used at every width (640 px, 24 px gutters).
 */
import { cx } from '@/lib/cx';

export interface Props {
	as?: 'div' | 'main' | 'header' | 'footer' | 'section' | undefined;
	id?: string | undefined;
	class?: string | undefined;
}

const { as: Tag = 'div', id, class: className } = Astro.props;
---

<Tag id={id} class={cx('mx-auto w-full max-w-screen-sm px-6', className)}>
	<slot />
</Tag>
