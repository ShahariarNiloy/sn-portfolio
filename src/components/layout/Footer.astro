---
/**
 * Footer — copyright, the live page-weight line and the site links
 * (About · Stack · Now · Uses · Guestbook · Contact · GitHub · LinkedIn). `#site-links` is where
 * the mobile Menu link lands when JavaScript is off.
 */
import PageWeight from '@/components/islands/PageWeight.astro';
import Link from '@/components/ui/Link.astro';

import Container from './Container.astro';

export interface Props {
	siteName: string;
	github: string;
	linkedin: string;
	/** Home adds "Built light, in Dhaka." after the copyright. */
	isHome?: boolean | undefined;
	location: string;
}

const { siteName, github, linkedin, isHome = false, location } = Astro.props;
const year = new Date().getUTCFullYear();
const links = [
	{ label: 'About', href: '/about' },
	{ label: 'Stack', href: '/stack' },
	{ label: 'Now', href: '/now' },
	{ label: 'Uses', href: '/uses' },
	{ label: 'Guestbook', href: '/guestbook' },
	{ label: 'Contact', href: '/contact' },
	{ label: 'GitHub', href: github },
	{ label: 'LinkedIn', href: linkedin },
];
---

<footer class={isHome ? 'mt-10' : 'mt-24'}>
	<Container class="flex flex-col flex-wrap justify-between gap-3 border-t border-line pt-8 pb-10 text-xs text-mut">
		<span class="flex flex-col gap-1.5">
			<small class="text-xs">
				&copy; {year} {siteName}
				{isHome && ` · Built light, in ${location}.`}
			</small>
			<PageWeight />
		</span>
		<nav id="site-links" aria-label="Site" class="-mx-1.5 flex flex-wrap items-start">
			{links.map((l) => (
				<Link href={l.href} variant="muted" class="inline-flex min-h-11 min-w-11 items-center px-1.5 text-sm">
					{l.label}
				</Link>
			))}
		</nav>
	</Container>
</footer>
