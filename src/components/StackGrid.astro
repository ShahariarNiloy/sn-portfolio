---
import { STACK_GRID } from '../data/site';

interface Props {
	/** "sm" on Home (68px cells), "lg" on the Stack page (104px cells + categories). */
	size?: 'sm' | 'lg';
}
const { size = 'sm' } = Astro.props;
const cell = size === 'lg' ? 104 : 68;

const blinks: Record<string, string> = { '0,1': '0s', '8,3': '-2s', '2,4': '-4s', '0,4': '-1s', '7,0': '-3s', '5,4': '-5s', '8,0': '-6s', '6,4': '-2.5s' };
const cells: { key: string; s?: (typeof STACK_GRID)[string]; dl?: string }[] = [];
for (let r = 0; r < 5; r++) for (let c = 0; c < 9; c++) cells.push({ key: `${c},${r}`, s: STACK_GRID[`${c},${r}`], dl: blinks[`${c},${r}`] });
const pluses = [[2, 1], [5, 1], [7, 3], [3, 4], [6, 2]].map(([x, y]) => ({ x: 1 + x * (cell + 1), y: 1 + y * (cell + 1) }));
---

<div class:list={['sgwrap', size]} aria-hidden="true" data-sgwrap>
	<div class="sgrid">
		{
			cells.map(({ s, dl }) =>
				s ? (
					<div class:list={['sc', 'on', { lrn: s[4] }]} style={`--c:${s[2]}`}>
						{size === 'lg' && <span class="scat">{s[3]}</span>}
						<span class="sym">{s[0]}</span>
						<span class="snm">{s[1]}</span>
					</div>
				) : (
					<div class:list={['sc', { blink: dl }]} style={dl ? `animation-delay:${dl}` : undefined} />
				),
			)
		}
	</div>
	{
		pluses.map((p) => (
			<svg class="plus" viewBox="0 0 11 11" style={`left:${p.x}px;top:${p.y}px`}>
				<path d="M5.5 0V11M0 5.5H11" />
			</svg>
		))
	}
</div>

<style>
	.sgwrap {
		position: relative;
		width: max-content;
		max-width: 100%;
		margin: 0 auto;
		--mx: 50%;
		--my: 42%;
		--cell: 68px;
		-webkit-mask-image: radial-gradient(ellipse 62% 72% at 50% 42%, #000 52%, transparent 92%);
		mask-image: radial-gradient(ellipse 62% 72% at 50% 42%, #000 52%, transparent 92%);
	}
	.sgwrap.lg {
		--cell: 104px;
	}
	.sgrid {
		display: grid;
		grid-template-columns: repeat(9, var(--cell));
		grid-auto-rows: var(--cell);
		gap: 1px;
		padding: 1px;
		background: radial-gradient(240px circle at var(--mx) var(--my), rgba(163, 165, 255, 0.6), transparent 72%), var(--line);
	}
	.sc {
		position: relative;
		background: var(--bg);
	}
	.sc.blink::after {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--accbg);
		opacity: 0;
		animation: cglow 7s ease-in-out infinite;
		animation-delay: inherit;
	}
	@keyframes cglow {
		50% {
			opacity: 0.9;
		}
	}
	.sc.on {
		background: radial-gradient(120% 85% at 50% 0%, color-mix(in srgb, var(--c) 13%, transparent), transparent 62%), var(--card);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
		transition: background 0.35s;
	}
	.sc.on:hover {
		background: radial-gradient(130% 100% at 50% 0%, color-mix(in srgb, var(--c) 30%, transparent), transparent 72%), var(--card);
	}
	.sc.lrn::before {
		content: '';
		position: absolute;
		inset: 4px;
		border: 1px dashed var(--line2);
		border-radius: 5px;
		pointer-events: none;
	}
	.lg .sc.lrn::before {
		inset: 6px;
		border-radius: 6px;
	}
	.sym {
		position: absolute;
		left: 0;
		right: 0;
		top: 15px;
		text-align: center;
		font-size: 19px;
		font-weight: 600;
		letter-spacing: -0.03em;
		color: var(--c);
		line-height: 1;
	}
	.lg .sym {
		top: 28px;
		font-size: 26px;
	}
	.sc.lrn .sym {
		opacity: 0.75;
	}
	.snm {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 9px;
		text-align: center;
		font-size: 9px;
		line-height: 1.2;
		color: var(--fg);
		opacity: 0.85;
	}
	.lg .snm {
		bottom: 15px;
		font-size: 11.5px;
	}
	.scat {
		position: absolute;
		right: 10px;
		top: 9px;
		font-family: var(--mono);
		font-size: 9.5px;
		line-height: 1.2;
		color: var(--mut);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	.plus {
		position: absolute;
		width: 11px;
		height: 11px;
		margin: -5px 0 0 -5px;
		color: var(--fg);
		opacity: 0.55;
		pointer-events: none;
		stroke: currentColor;
		stroke-width: 1;
		fill: none;
	}
	@media (max-width: 700px) {
		.sgwrap {
			width: 100%;
			-webkit-mask-image: none;
			mask-image: none;
		}
		.sgrid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.sc:not(.on),
		.plus {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.sc.blink::after {
			animation: none;
		}
	}
</style>

<script>
	// Spotlight on the grid lines follows the pointer.
	document.querySelectorAll<HTMLElement>('[data-sgwrap]').forEach((el) => {
		el.addEventListener('pointermove', (e) => {
			const r = el.getBoundingClientRect();
			el.style.setProperty('--mx', `${e.clientX - r.left}px`);
			el.style.setProperty('--my', `${e.clientY - r.top}px`);
		});
		el.addEventListener('pointerleave', () => {
			el.style.setProperty('--mx', '50%');
			el.style.setProperty('--my', '42%');
		});
	});
</script>
