---
/**
 * StatGrid — big numbers with mono labels, in cards. Two columns when asked
 * (and for four items), otherwise as many 144 px columns as fit.
 */
import { cx } from '@/lib/cx';

export interface Props {
	items: { value: string; label: string }[];
	columns?: 2 | 'auto' | undefined;
}

const { items, columns = 'auto' } = Astro.props;
---

<dl class={cx('m-0 grid gap-3', columns === 2 ? 'grid-cols-2' : 'grid-cols-2 sm:grid-cols-3')}>
	{items.map((s) => (
		<div class="flex flex-col-reverse justify-end rounded-xl border border-line bg-card p-4">
			{/* The label is the term; the number shows first. */}
			<dt>
				<span class="font-mono text-xs text-mut">{s.label}</span>
			</dt>
			<dd class="m-0">
				<span class="block text-2xl font-semibold tracking-tight text-fg">{s.value}</span>
			</dd>
		</div>
	))}
</dl>
