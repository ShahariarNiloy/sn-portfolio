---
/**
 * NoteWall — the newest Guestbook notes on Home, one per row: the note in serif,
 * then the visitor's mosaic, name and date. Plain text, never HTML.
 */
import Mosaic from '@/components/ui/Mosaic.astro';
import { formatDay, formatIsoDay, parseUtcTimestamp } from '@/lib/format';
import type { Note } from '@/lib/guestbook/db';

export interface Props {
	/** Newest first. */
	notes: Note[];
}

const { notes } = Astro.props;
const rows = notes.map((note) => ({ ...note, date: parseUtcTimestamp(note.createdAt) }));
---

{rows.length ? (
	<ul class="m-0 list-none border-b border-line p-0">
		{rows.map((note) => (
			<li class="border-t border-line py-6">
				<p class="m-0 font-serif text-2xl leading-snug wrap-anywhere text-fg">“{note.body}”</p>
				<div class="mt-4 flex items-center gap-3">
					<Mosaic githubId={note.githubId} />
					<span class="min-w-0 truncate text-sm text-fg">{note.githubName}</span>
					<time datetime={formatIsoDay(note.date)} class="ml-auto font-mono text-xs whitespace-nowrap text-mut">
						{formatDay(note.date)}
					</time>
				</div>
			</li>
		))}
	</ul>
) : (
	<p class="m-0 border-y border-line py-6 font-serif text-2xl leading-snug text-mut">Nobody has signed yet. Yours could be the first note.</p>
)}
