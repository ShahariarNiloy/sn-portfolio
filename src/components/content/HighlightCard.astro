---
/**
 * HighlightCard — one card on Home's highlights carousel: illustration, title link
 * (the whole card is clickable through it) and a one-line summary.
 */
import type { CollectionEntry } from 'astro:content';

import Illustration from '@/components/illustrations/Illustration.astro';

export interface Props {
	highlight: CollectionEntry<'highlights'>;
}

const { highlight } = Astro.props;
---

<li class="relative flex w-64 shrink-0 snap-start flex-col gap-3.5 rounded-xl border border-line bg-card p-4 transition-colors duration-300 ease-out hover:border-line2">
	<div class="flex h-36 items-center justify-center">
		<Illustration name={highlight.data.illustration} size="card" />
	</div>
	<div>
		<h3 class="m-0 text-sm font-semibold">
			<a href={`/highlights/${highlight.id}`} class="text-fg no-underline after:absolute after:inset-0 after:rounded-xl">
				{highlight.data.title}{' '}
				<span class="text-mut" aria-hidden="true">
					→
				</span>
			</a>
		</h3>
		<p class="mt-1 mb-0 text-sm leading-normal text-mut">{highlight.data.card}</p>
	</div>
</li>
