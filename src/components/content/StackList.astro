---
/**
 * StackList — Home's Stack section: one row per group (core, also in production,
 * learning), a mono label then each tool as a grey logo and its name. A long group
 * lists only its featured tools and links the rest to /stack. Same data and groups as /stack.
 */
import type { CollectionEntry } from 'astro:content';

import Icon from '@/components/ui/Icon.astro';
import Link from '@/components/ui/Link.astro';
import type { IconName } from '@/components/ui/icons';
import { STACK_GROUPS } from '@/lib/stack';

export interface Props {
	items: CollectionEntry<'stack'>[];
}

const { items } = Astro.props;
const rows = STACK_GROUPS.map((g) => {
	const all = items.filter((i) => i.data.group === g.id);
	// A long group shows its featured tools, or its first six if none are marked (e.g. a
	// content cache from before `featured` existed), and links the rest to /stack.
	const featured = all.filter((i) => i.data.featured);
	const tools = all.length <= 6 ? all : featured.length ? featured : all.slice(0, 6);
	return { ...g, tools, more: all.length - tools.length };
});
---

<div class="flex flex-col">
	{rows.map((row) => (
		<div class="grid grid-cols-1 items-baseline gap-x-6 gap-y-3 py-5 sm:grid-cols-stack">
			<h3 class="m-0 font-mono text-xs font-normal text-mut">{row.label}</h3>
			<ul class="m-0 flex list-none flex-wrap gap-x-5 gap-y-3 p-0 text-sm">
				{row.tools.map((tool) => (
					<li class="inline-flex items-baseline gap-2 font-medium whitespace-nowrap text-fg">
						<span class="self-center text-mut opacity-75 grayscale">
							<Icon name={tool.data.icon as IconName} shared />
						</span>
						{tool.data.name}
					</li>
				))}
				{row.more > 0 && (
					<li class="inline-flex items-baseline">
						<Link href="/stack">
							+{row.more} more<span class="sr-only"> tools, on the Stack page</span>
						</Link>
					</li>
				)}
			</ul>
		</div>
	))}
</div>
