---
/**
 * Timeline — the year-by-year list on /timeline. Each year is a heading with a
 * rail of entries under it: "Mon · Kind", the title, the place (the part of the
 * title after " · ") and the detail. Roles, milestones and "Now" get their own dots.
 */
import type { CollectionEntry } from 'astro:content';

import Inline from '@/components/ui/Inline.astro';
import { cx } from '@/lib/cx';
import { formatTimelineMeta } from '@/lib/timeline';

type Entry = CollectionEntry<'timeline'>['data'];

export interface Props {
	years: { year: string; entries: Entry[] }[];
}

const { years } = Astro.props;
const KIND_LABEL: Record<Entry['kind'], string> = {
	life: 'Life',
	education: 'Education',
	role: 'Role',
	research: 'Research',
	certificate: 'Certificate',
	award: 'Award',
	now: 'Now',
};
const marker = (kind: Entry['kind']): string => {
	if (kind === 'role') return 'is-role';
	if (kind === 'award' || kind === 'research') return 'is-milestone';
	if (kind === 'now') return 'is-now';
	return '';
};
/** "Junior Software Engineer · Sheba Technologies" → title and place. */
const splitTitle = (title: string): { name: string; place: string | undefined } => {
	const [name = title, ...rest] = title.split(' · ');
	return { name, place: rest.length ? rest.join(' · ') : undefined };
};
---

<ol class="m-0 list-none p-0">
	{years.map((y) => (
		<li>
			<h3 class="m-0 mb-5 text-xl font-semibold tracking-tight text-head">{y.year}</h3>
			<ul class="m-0 list-none border-l border-line2 p-0 pb-12 pl-7">
				{y.entries.map((e) => {
					const { name, place } = splitTitle(e.title);
					return (
						<li class={cx('timeline-entry relative max-w-lg pb-8', marker(e.kind))}>
							<p class="m-0 mb-1.5 font-mono text-xs text-mut">{formatTimelineMeta(e.month, KIND_LABEL[e.kind])}</p>
							<p class="m-0 text-base font-medium text-fg">{name}</p>
							{place && <p class="m-0 text-sm text-fg">{place}</p>}
							{e.body && (
								<p class="m-0 mt-2 text-sm leading-relaxed text-mut">
									<Inline text={e.body} />
								</p>
							)}
						</li>
					);
				})}
			</ul>
		</li>
	))}
</ol>
