---
/**
 * WorkRow — one project in a list: name, badge, period and a one-line description.
 * Used on Home ("Work") and /work. The whole row is the link target, so nothing
 * inside it is focusable.
 */
import type { CollectionEntry } from 'astro:content';

import Pill from '@/components/ui/Pill.astro';

export interface Props {
	project: CollectionEntry<'projects'>;
	/** Home uses the shorter description and label, and badges only the company project. */
	context: 'home' | 'work';
}

const { project, context } = Astro.props;
const { name, badge, lighthouse, group } = project.data;
const isHome = context === 'home';
const summary = (isHome && project.data.homeSummary) || project.data.summary;
const period = (isHome && project.data.homePeriod) || project.data.period;
const showBadge = badge && (!isHome || group === 'company');
// The Lighthouse badge appears only on /work, where scores are explained.
const showLighthouse = !isHome && lighthouse;
---

<a
	href={`/work/${project.id}`}
	class="group relative -mx-3.5 grid grid-cols-row items-baseline gap-x-4 gap-y-1.5 rounded-xl px-3.5 py-4 no-underline transition-colors duration-200 ease-out hover:bg-card"
>
	<span class="inline-flex flex-wrap items-center gap-2 font-medium text-fg">
		{name}
		{showBadge && <Pill>{badge}</Pill>}
		{showLighthouse && <Pill tone="good">Lighthouse {lighthouse.performance}</Pill>}
		<span
			class="inline-block text-mut transition-transform duration-200 ease-out group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-fg"
			aria-hidden="true"
		>
			↗
		</span>
	</span>
	<span class="font-mono text-xs text-mut">{period}</span>
	<span class="col-span-full -mt-0.5 text-sm text-mut">{summary}</span>
</a>
