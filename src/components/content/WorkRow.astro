---
/**
 * WorkRow — one project in a list: name, badge, period and a one-line description.
 * Used on Home ("Work") and, with a thumbnail, on /work. The whole row is the link target, so nothing
 * inside it is focusable.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

import Pill from '@/components/ui/Pill.astro';
import { cx } from '@/lib/cx';

export interface Props {
	project: CollectionEntry<'projects'>;
	/** Home uses the shorter description and label, and badges only the company project. */
	context: 'home' | 'work';
}

const { project, context } = Astro.props;
const { name, badge, group, thumbnail } = project.data;
const isHome = context === 'home';
const summary = (isHome && project.data.homeSummary) || project.data.summary;
const period = (isHome && project.data.homePeriod) || project.data.period;
const showBadge = badge && (!isHome || group === 'company');
---

<a
	href={`/work/${project.id}`}
	class={cx(
		'relative -mx-3.5 rounded-xl px-3.5 py-4 no-underline transition-colors duration-200 ease-out hover:bg-card',
		!isHome && 'grid grid-cols-intro items-center gap-3 sm:gap-4',
		isHome && 'block',
	)}
>
	{!isHome &&
		(thumbnail ? (
			<Image
				src={thumbnail}
				alt=""
				width={384}
				format="avif"
				quality={85}
				loading="lazy"
				class="block h-9 w-20 rounded-lg border border-line2 bg-card2 object-cover object-top sm:h-16 sm:w-32"
			/>
		) : (
			<span
				class="flex h-9 w-20 items-center justify-center rounded-lg border border-dashed border-line2 bg-card2 font-mono text-xs text-mut sm:h-16 sm:w-32"
				aria-hidden="true"
			>
				<span class="max-sm:hidden">{badge}</span>
			</span>
		))}
	<span class="grid min-w-0 grid-cols-row items-baseline gap-x-4 gap-y-1">
		<span class="inline-flex flex-wrap items-center gap-2 font-medium text-fg">
			{name}
			{showBadge && <Pill>{badge}</Pill>}
		</span>
		<span class="font-mono text-meta text-mut">{period}</span>
		<span class="col-span-full text-sm text-mut">{summary}</span>
	</span>
</a>
