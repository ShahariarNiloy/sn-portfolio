---
/**
 * HomeList — the "→ line" list used in Home's Now section; **bold** words only
 * brighten. Also the two-column period rows (Experience).
 */
import Inline from '@/components/ui/Inline.astro';

export interface Props {
	variant: 'arrows' | 'rows';
	/** For `arrows`: the lines. */
	lines?: string[] | undefined;
	/** For `rows`: a mono key, a title and one line. */
	rows?: { key: string; title: string; body: string }[] | undefined;
}

const { variant, lines = [], rows = [] } = Astro.props;
---

{variant === 'arrows' ? (
	<ul class="m-0 flex list-none flex-col gap-2.5 p-0 text-mut">
		{lines.map((line) => (
			<li class="flex gap-3">
				<span class="text-acc" aria-hidden="true">
					→
				</span>
				<span>
					<Inline text={line} emphasis="fg" />
				</span>
			</li>
		))}
	</ul>
) : (
	<div class="border-b border-line">
		{rows.map((row) => (
			<div class="grid grid-cols-1 gap-0.5 border-t border-line py-3.5 sm:grid-cols-label sm:gap-4">
				<span class="pt-0.5 font-mono text-xs text-mut">{row.key}</span>
				<div>
					<div class="font-medium">{row.title}</div>
					<div class="text-sm text-mut">{row.body}</div>
				</div>
			</div>
		))}
	</div>
)}
