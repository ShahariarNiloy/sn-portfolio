---
/**
 * ContactLine — Home's contact sentence, with `{email}`, `{github}` and
 * `{linkedin}` tokens rendered as links.
 */
import Link from '@/components/ui/Link.astro';

export interface Props {
	sentence: string;
	email: string;
	github: string;
	linkedin: string;
}

const { sentence, email, github, linkedin } = Astro.props;
const LINKS: Record<string, { href: string; text: string }> = {
	email: { href: `mailto:${email}`, text: email },
	github: { href: github, text: 'GitHub' },
	linkedin: { href: linkedin, text: 'LinkedIn' },
};
const parts = sentence.split(/(\{email\}|\{github\}|\{linkedin\})/);
---

<p class="m-0 text-base text-mut">
	{parts.map((part) => {
		const link = LINKS[part.slice(1, -1)];
		return link ? <Link href={link.href}>{link.text}</Link> : part;
	})}
</p>
