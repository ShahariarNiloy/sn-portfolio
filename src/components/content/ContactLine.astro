---
/**
 * ContactLine — Home's contact sentence, with `{email}`, `{github}` and
 * `{linkedin}` tokens rendered as links, then links to the pages about me.
 */
import Link from '@/components/ui/Link.astro';

export interface Props {
	sentence: string;
	email: string;
	github: string;
	linkedin: string;
}

const { sentence, email, github, linkedin } = Astro.props;
const LINKS: Record<string, { href: string; text: string }> = {
	email: { href: `mailto:${email}`, text: email },
	github: { href: github, text: 'GitHub' },
	linkedin: { href: linkedin, text: 'LinkedIn' },
};
const parts = sentence.split(/(\{email\}|\{github\}|\{linkedin\})/);
---

<address class="not-italic">
	<p class="m-0 text-base text-mut max-sm:leading-9">
		{parts.map((part) => {
			const link = LINKS[part.slice(1, -1)];
			return link ? <Link href={link.href}>{link.text}</Link> : part;
		})}
	</p>
</address>
<p class="mt-6 mb-0 text-sm text-mut">
	More about me: <Link href="/about" text="About" /> · <Link href="/stack" class="-mx-2 px-2" text="Stack" /> ·{' '}
	<Link href="/now" class="-mx-2 px-2" text="Now" /> · <Link href="/uses" class="-mx-2 px-2" text="Uses" /> · <Link href="/guestbook" text="Guestbook" />
</p>
