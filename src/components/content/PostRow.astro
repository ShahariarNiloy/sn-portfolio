---
/**
 * PostRow — one blog post on /blog: title and summary.
 */
export interface Props {
	href: string;
	title: string;
	summary?: string | undefined;
}

const { href, title, summary } = Astro.props;
---

<a href={href} class="-mx-3.5 grid min-h-11 gap-y-1.5 rounded-xl px-3.5 py-4 no-underline transition-colors duration-200 ease-out hover:bg-card">
	<span class="leading-snug font-medium text-fg">{title}</span>
	{summary && <span class="text-sm leading-normal text-mut">{summary}</span>}
</a>
