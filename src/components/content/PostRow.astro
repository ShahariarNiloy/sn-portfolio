---
/**
 * PostRow — one blog post on /blog: title, read time and summary.
 */
export interface Props {
	href: string;
	title: string;
	summary?: string | undefined;
	/** "2 min read". */
	meta: string;
}

const { href, title, summary, meta } = Astro.props;
---

<a
	href={href}
	class="-mx-3.5 grid min-h-11 grid-cols-row items-baseline gap-x-4 gap-y-1.5 rounded-xl px-3.5 py-4 no-underline transition-colors duration-200 ease-out hover:bg-card"
>
	<span class="leading-snug font-medium text-fg">{title}</span>
	<span class="font-mono text-xs whitespace-nowrap text-mut">{meta}</span>
	{summary && <span class="col-span-full text-sm leading-normal text-mut">{summary}</span>}
</a>
