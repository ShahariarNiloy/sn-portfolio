---
/**
 * PrincipleGrid — two columns of short principle cards (title + one line), used in
 * case studies. One column below sm.
 */
import Inline from '@/components/ui/Inline.astro';

export interface Props {
	items: { title: string; body: string }[];
}

const { items } = Astro.props;
---

<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
	{items.map((p) => (
		<div class="rounded-xl border border-line bg-card p-4">
			<b class="mb-1.5 block font-semibold tracking-tight text-head">{p.title}</b>
			<span class="text-sm leading-relaxed text-mut">
				<Inline text={p.body} />
			</span>
		</div>
	))}
</div>
