---
/**
 * PrincipleGrid — two columns of short principle cards (title + one line), used in
 * case studies. One column below sm.
 */
import Inline from '@/components/ui/Inline.astro';

export interface Props {
	items: { title: string; body: string }[];
}

const { items } = Astro.props;
---

<ul class="m-0 grid list-none grid-cols-1 gap-3 p-0 sm:grid-cols-2">
	{items.map((p) => (
		<li class="rounded-xl border border-line bg-card p-4">
			<h3 class="m-0 mb-1.5 text-sm/relaxed font-semibold tracking-tight text-head">{p.title}</h3>
			<span class="text-sm leading-relaxed text-mut">
				<Inline text={p.body} />
			</span>
		</li>
	))}
</ul>
