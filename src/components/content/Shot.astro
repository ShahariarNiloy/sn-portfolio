---
/**
 * Shot — a framed screenshot on a project page, with an optional mono caption.
 * Served whole, as AVIF with a WebP fallback: smaller copies would be resampled
 * twice (by the build, then the browser), which blurs interface text on 1× screens.
 * `sm` is the tighter frame used for the small cells of ShotGrid.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

import { cx } from '@/lib/cx';

export interface Props {
	/** The imported screenshot. */
	src: ImageMetadata;
	/** What the screenshot shows. */
	alt: string;
	caption?: string | undefined;
	size?: 'md' | 'sm' | undefined;
}

const { src, alt, caption, size = 'md' } = Astro.props;
---

<figure class="m-0">
	<div class={cx('mt-2 rounded-xl border border-line2 bg-card', size === 'md' ? 'p-2' : 'p-1')}>
		<Picture
			src={src}
			alt={alt}
			formats={['avif', 'webp']}
			fallbackFormat="webp"
			quality={85}
			loading="lazy"
			class={cx('block h-auto w-full', size === 'md' ? 'rounded-lg' : 'rounded-md')}
		/>
	</div>
	{caption && <figcaption class="mt-2 font-mono text-xs text-mut">{caption}</figcaption>}
</figure>
