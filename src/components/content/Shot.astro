---
/**
 * Shot — a framed screenshot on a project page, with an optional mono caption.
 * Served whole, as AVIF (quality 50) with a WebP fallback: smaller copies would be resampled
 * twice (by the build, then the browser), which blurs interface text on 1× screens.
 * Breaks out of the text column unless it sits in a ShotGrid (`inGrid`), and opens
 * full size in a new tab. `sm` is the tighter frame for ShotGrid's small cells.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

import { cx } from '@/lib/cx';

export interface Props {
	/** The imported screenshot. */
	src: ImageMetadata;
	/** What the screenshot shows. */
	alt: string;
	caption?: string | undefined;
	size?: 'md' | 'sm' | undefined;
	/** Inside a ShotGrid, which breaks out itself. */
	inGrid?: boolean | undefined;
}

const { src, alt, caption, size = 'md', inGrid = false } = Astro.props;
// AVIF at 50 matches the WebP source by eye (sharp keeps full colour detail, which keeps text crisp) at
// about 40% fewer bytes than AVIF at 85. The WebP fallback, for browsers without AVIF, keeps 85.
const [avif, webp] = await Promise.all([getImage({ src, format: 'avif', quality: 50 }), getImage({ src, format: 'webp', quality: 85 })]);
---

<figure class={cx('m-0', !inGrid && 'breakout')}>
	<a
		href={avif.src}
		target="_blank"
		rel="noopener"
		class={cx(
			'mt-2 block cursor-zoom-in rounded-xl border border-line2 bg-card transition-colors duration-200 ease-out hover:border-mut',
			size === 'md' ? 'p-2' : 'p-1',
		)}
	>
		<picture>
			<source srcset={avif.src} type="image/avif" />
			<img
				src={webp.src}
				alt={alt}
				width={src.width}
				height={src.height}
				loading="lazy"
				decoding="async"
				class={cx('block h-auto w-full', size === 'md' ? 'rounded-lg' : 'rounded-md')}
			/>
		</picture>
		<span class="sr-only">(opens full size in a new tab)</span>
	</a>
	{caption && <figcaption class="mt-2 font-mono text-xs text-mut">{caption}</figcaption>}
</figure>
