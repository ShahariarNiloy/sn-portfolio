---
/**
 * HomeIntro — Home's hero: the title, the round avatar beside the intro text (which wraps around it on phones),
 * the sentence with the LinkedIn pill, and the facts row. The only animated block on Home. The avatar
 * is the shared Avatar component (one cached file for Home and About).
 */
import Avatar from '@/components/ui/Avatar.astro';
import CtaPill from '@/components/ui/CtaPill.astro';
import Inline from '@/components/ui/Inline.astro';

export interface Props {
	title: [string, string];
	intro: string;
	cta: { text: string; label: string };
	linkedin: string;
	facts: { label: string; value: string }[];
	name: string;
}

const { title, intro, cta, linkedin, facts, name } = Astro.props;
---

<section aria-label="Introduction" class="pt-24 pb-6 motion-safe:animate-rise max-sm:pt-12">
	<h1 class="m-0 text-3xl leading-tight font-semibold tracking-tight sm:text-4xl">
		<span class="text-fg">{title[0]}</span> <span class="text-fade">{title[1]}</span>
	</h1>
	<div class="mt-8 items-start max-sm:flow-root sm:mt-10 sm:grid sm:grid-cols-intro sm:gap-6">
		{/* On phones the text hugs the circle (shape-outside) instead of the square box around it. */}
		<Avatar
			name={name}
			class="size-24 max-sm:float-left max-sm:mr-4 max-sm:mb-2 max-sm:[shape-margin:0.875rem] max-sm:[shape-outside:circle(50%_at_50%_50%)_border-box]"
		/>
		<div>
			<p class="m-0 text-base leading-relaxed text-mut">
				<Inline text={intro} />
			</p>
			<p class="mt-6 mb-0 text-base leading-7 text-mut">
				{cta.text}{' '}
				<CtaPill href={linkedin} srSuffix="on LinkedIn" class="max-sm:mt-2 sm:ml-1">
					{cta.label}
				</CtaPill>
			</p>
		</div>
	</div>
	<dl class="mt-10 mb-0 flex flex-wrap gap-x-8 gap-y-3 border-t border-line pt-5 sm:mt-14 sm:gap-x-10">
		{facts.map((f) => (
			<div class="flex flex-col gap-0.5">
				<dt class="font-mono text-xs text-mut">{f.label}</dt>
				<dd class="m-0 text-sm">{f.value}</dd>
			</div>
		))}
	</dl>
</section>
