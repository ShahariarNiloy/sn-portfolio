---
/**
 * ShotGrid — five captioned screenshots under a project's main one: two wide,
 * then three small, in the same breakout width. One column below md.
 */
import type { ImageMetadata } from 'astro';

import { cx } from '@/lib/cx';

import Shot from './Shot.astro';

export interface Props {
	/** The screenshots, in order; the first two get the wide cells. */
	items: { src: ImageMetadata; alt: string; caption: string }[];
}

const { items } = Astro.props;
---

<ul class="mt-6 mb-0 breakout grid list-none grid-cols-1 gap-x-4 gap-y-6 md:grid-cols-6">
	{items.map((item, i) => (
		<li class={cx(i < 2 ? 'md:col-span-3' : 'md:col-span-2')}>
			<Shot {...item} size={i < 2 ? 'md' : 'sm'} inGrid />
		</li>
	))}
</ul>
