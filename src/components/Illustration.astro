---
import type { Illustration } from '../lib/illustrations';

interface Props {
	ill: Illustration;
	w: number;
	h: number;
	maxWidth?: string;
}
const { ill, w, h, maxWidth } = Astro.props;
---

<svg class="ill" viewBox={`0 0 ${w} ${h}`} aria-hidden="true" style={`aspect-ratio:${w} / ${h};${maxWidth ? `max-width:${maxWidth};` : ''}`}>
	<g class="gfade">{ill.ghost.map((p) => <path d={p.d} class={p.c} />)}</g>
	<g class="drawn">{ill.draw.map((p) => <path d={p.d} class={p.c} pathLength="1" style={`--d:${p.dl}`} />)}</g>
	<g class="drawn flt">{ill.float.map((p) => <path d={p.d} class={p.c} pathLength="1" style={`--d:${p.dl}`} />)}</g>
</svg>

<style is:global>
	/* Draw-on runs when an ancestor .cap gets "armed inview" (see drawOnScroll). */
	.ill { display: block; width: 100%; height: auto; overflow: visible; --ist: rgba(255, 255, 255, 0.3); --ist2: rgba(255, 255, 255, 0.5); --iacc: #5b7bff; }
	.ill path { stroke-linejoin: round; stroke-linecap: round; }
	.ill .f-top, .ill .f-side, .ill .f-front { fill: var(--card); stroke: var(--ist); stroke-width: 1; }
	.ill .acc.f-top, .ill .acc.f-side, .ill .acc.f-front { fill: var(--card); stroke: var(--iacc); stroke-width: 1.1; }
	.ill .ghost { fill: none !important; stroke: var(--ist); stroke-dasharray: 3 3; opacity: 0.75; }
	.ill .sl { fill: none; stroke: var(--ist); stroke-width: 1; }
	.ill .sl2 { fill: none; stroke: var(--ist2); stroke-width: 1; }
	.ill .accl { fill: none; stroke: var(--iacc); stroke-width: 1.2; }
	.ill .dotf { fill: var(--iacc); stroke: none; }
	.ill .dotg { fill: var(--ist2); stroke: none; }
	.ill .guide { fill: none; stroke: var(--ist); stroke-width: 1; stroke-dasharray: 1.5 3.5; }
	.ill .body { fill: var(--card); stroke: var(--ist); stroke-width: 1; }
	.ill .pix { fill: var(--ist2); stroke: none; }
	.ill .accfill { fill: color-mix(in srgb, var(--iacc) 32%, transparent); stroke: var(--iacc); stroke-width: 1; }
	.cap.armed .ill .drawn path { stroke-dasharray: 1; stroke-dashoffset: 1; }
	.cap.armed .ill .drawn path[class*='f-'], .cap.armed .ill .drawn path.dotf, .cap.armed .ill .drawn path.body, .cap.armed .ill .drawn path.pix, .cap.armed .ill .drawn path.accfill { fill-opacity: 0; }
	.cap.armed .ill .gfade { opacity: 0; }
	.cap.armed.inview .ill .drawn path { animation: drawon 1.3s cubic-bezier(0.6, 0, 0.2, 1) forwards, fillin 0.6s ease forwards; animation-delay: var(--d), calc(var(--d) + 0.8s); }
	.cap.armed.inview .ill .gfade { animation: fadein2 0.8s ease 1.1s forwards; }
	.cap.inview .ill .flt { animation: bob 5s ease-in-out 2.4s infinite; }
	@keyframes drawon { to { stroke-dashoffset: 0; } }
	@keyframes fillin { to { fill-opacity: 1; } }
	@keyframes fadein2 { to { opacity: 1; } }
	@keyframes bob { 50% { transform: translateY(-8px); } }
	@media (prefers-reduced-motion: reduce) {
		.cap.armed .ill .drawn path { stroke-dasharray: none; stroke-dashoffset: 0; fill-opacity: 1; animation: none; }
		.cap.armed .ill .gfade { opacity: 1; animation: none; }
		.cap .ill .flt { animation: none; }
	}
</style>

<script>
	// Arm every .cap block, then draw it once it scrolls into view.
	document.querySelectorAll<HTMLElement>('.cap:not(.inview)').forEach((cap) => {
		if (!('IntersectionObserver' in window)) return;
		cap.classList.add('armed');
		const io = new IntersectionObserver(
			(entries) => {
				if (entries.some((e) => e.isIntersecting)) {
					cap.classList.add('inview');
					io.disconnect();
				}
			},
			{ threshold: 0.15 },
		);
		io.observe(cap);
	});
</script>
