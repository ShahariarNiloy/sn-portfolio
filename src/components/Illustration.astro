---
import type { Illustration } from '../lib/illustrations';

interface Props {
	ill: Illustration;
	w: number;
	h: number;
	maxWidth?: string;
	labels?: { x: number; y: number; text: string }[];
}
const { ill, w, h, maxWidth, labels = [] } = Astro.props;
---

<svg
	class="ill"
	viewBox={`0 0 ${w} ${h}`}
	aria-hidden="true"
	style={`aspect-ratio:${w} / ${h};${maxWidth ? `max-width:${maxWidth};` : ''}`}
>
	<g class="gfade">{ill.ghost.map((p) => <path d={p.d} class={p.c} />)}</g>
	<g class="drawn">{ill.draw.map((p) => <path d={p.d} class={p.c} pathLength="1" style={`--d:${p.dl}`} />)}</g>
	<g class="drawn flt">{ill.float.map((p) => <path d={p.d} class={p.c} pathLength="1" style={`--d:${p.dl}`} />)}</g>
	{
		labels.length > 0 && (
			<g class="ilabs">
				{labels.map((l) => (
					<text x={l.x} y={l.y} class="ilab">
						{l.text}
					</text>
				))}
			</g>
		)
	}
</svg>
