---
import { NAV, SITE } from '../data/site';

interface Props {
	current: string;
	hideCta?: boolean;
}
const { current, hideCta = false } = Astro.props;
---

<header class="site-header">
	<div class="wrap bar">
		<div class="left">
			<a href="/" class="brand">
				<img src="/images/logo.png" alt={`${SITE.name}, home`} width="27" height="24" />
			</a>
			<nav aria-label="Primary" class="nav">
				{
					NAV.map((item) => (
						<a
							href={item.href}
							class:list={['nl', { on: item.href === current }]}
							aria-current={item.href === current ? 'page' : undefined}
						>
							{item.label}
						</a>
					))
				}
			</nav>
		</div>
		<div class="right">
			{!hideCta && <a href="/contact" class="btn">Get in touch</a>}
		</div>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--line);
		position: relative;
		z-index: 2;
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding-top: 10px;
		padding-bottom: 10px;
		flex-wrap: wrap;
	}
	.left {
		display: flex;
		align-items: center;
		gap: 20px;
		flex-wrap: wrap;
	}
	.brand {
		display: flex;
		align-items: center;
		padding: 10px 0;
	}
	.brand img {
		height: 24px;
		width: auto;
		display: block;
	}
	.nav {
		display: flex;
		flex-wrap: wrap;
	}
	.right {
		display: flex;
		align-items: center;
		gap: 8px;
	}
</style>

