---
import { NAV, SITE } from '../data/site';

interface Props {
	current: string;
	home?: boolean;
}
const { current, home = false } = Astro.props;
---

<header class="col site-header">
	<a href={home ? '#top' : '/'} class="brand">
		<img src="/images/logo.png" alt={`${SITE.name}, home`} width="25" height="22" />
	</a>
	<nav aria-label="Primary" class="nav">
		{
			NAV.map((item) => (
				<a href={home && item.href.startsWith('/#') ? item.href.slice(1) : item.href} class="navl" aria-current={item.href === current ? 'page' : undefined}>
					{item.label}
				</a>
			))
		}
	</nav>
</header>

<style>
	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding-top: 20px;
		padding-bottom: 20px;
		flex-wrap: wrap;
		position: relative;
		z-index: 2;
	}
	.brand {
		display: flex;
		align-items: center;
		padding: 10px 0;
	}
	.brand img {
		height: 22px;
		width: auto;
		display: block;
	}
	.nav {
		display: flex;
		flex-wrap: wrap;
	}
</style>
