---
import { NAV, OFF_THE_CLOCK, SITE } from '../data/site';

interface Props {
	current: string;
	home?: boolean;
}
const { current, home = false } = Astro.props;
---

<header class="col site-header">
	<a href={home ? '#top' : '/'} class="brand">
		<img src="/images/logo.png" alt={`${SITE.name}, home`} width="25" height="22" />
	</a>
	<nav aria-label="Primary" class="nav">
		{
			NAV.map((item) => (
				<a href={home && item.href.startsWith('/#') ? item.href.slice(1) : item.href} class="navl" aria-current={item.href === current ? 'page' : undefined}>
					{item.label}
				</a>
			))
		}
		<span class="navsep" aria-hidden="true"></span>
		<a href={OFF_THE_CLOCK.href} class="navl navoff" aria-current={OFF_THE_CLOCK.href === current ? 'page' : undefined}>{OFF_THE_CLOCK.label}</a>
		<button type="button" class="kbtn" data-openk aria-label="Open the page menu"><kbd>⌘K</kbd></button>
	</nav>
</header>

<style>
	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding-top: 20px;
		padding-bottom: 20px;
		flex-wrap: wrap;
		position: relative;
		z-index: 2;
	}
	.brand {
		display: flex;
		align-items: center;
		padding: 10px 0;
	}
	.brand img {
		height: 22px;
		width: auto;
		display: block;
	}
	.nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
	}
	.navsep {
		width: 1px;
		height: 14px;
		background: var(--line2);
		margin: 0 10px;
	}
	.navoff {
		font-family: var(--serif);
		font-style: italic;
		font-size: 17px !important;
		letter-spacing: 0;
	}
	.kbtn {
		background: transparent;
		border: 0;
		padding: 8px 0 8px 12px;
		cursor: pointer;
		color: var(--mut);
	}
	.kbtn kbd {
		font-family: var(--mono);
		font-size: 11px;
		border: 1px solid var(--line2);
		border-radius: 6px;
		padding: 3px 6px;
		color: var(--mut);
		transition: color 0.2s, border-color 0.2s;
	}
	.kbtn:hover kbd {
		color: var(--fg);
		border-color: var(--mut);
	}
</style>
