---
import { SITE } from '../data/site';

interface Props {
	home?: boolean;
}
const { home = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class:list={['col', 'foot', { home }]}>
	<span>© {year} {SITE.name}</span>
	{
		home ? (
			<span>Built light, in Dhaka.</span>
		) : (
			<span class="links">
				<a href={`mailto:${SITE.email}`} class="navl">Email</a>
				<a href={SITE.github} class="navl" target="_blank" rel="noopener">GitHub</a>
				<a href={SITE.linkedin} class="navl" target="_blank" rel="noopener">LinkedIn</a>
			</span>
		)
	}
</footer>

<style>
	.foot {
		margin-top: 96px;
		padding-top: 28px;
		padding-bottom: 40px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px;
		flex-wrap: wrap;
		font-size: 13px;
		color: var(--mut);
		border-top: 1px solid var(--line);
	}
	.foot.home {
		margin-top: 40px;
		padding-top: 32px;
	}
	.links {
		display: flex;
		gap: 18px;
		flex-wrap: wrap;
	}
	.links .navl {
		padding: 8px 0;
		font-size: 13px;
	}
</style>
