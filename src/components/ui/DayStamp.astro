---
/**
 * DayStamp — a published date ("24 Nov 2026") in mono, as a <time>.
 */
import { cx } from '@/lib/cx';
import { formatDay, formatIsoDay } from '@/lib/format';

export interface Props {
	date: Date;
	class?: string | undefined;
}

const { date, class: className } = Astro.props;
---

<time datetime={formatIsoDay(date)} class={cx('font-mono text-xs whitespace-nowrap text-mut', className)}>
	{formatDay(date)}
</time>
