---
/**
 * Pill — small rounded mono label: project badges, draft markers, timeline kinds,
 * the Lighthouse badge (`good`, with a green dot).
 */
import { cx } from '@/lib/cx';

export interface Props {
	tone?: 'neutral' | 'acc' | 'good' | undefined;
	/** Dashed border, used for drafts. */
	dashed?: boolean | undefined;
	class?: string | undefined;
}

const { tone = 'neutral', dashed = false, class: className } = Astro.props;
---

<span
	class={cx(
		'inline-flex items-center gap-1.5 rounded-full border align-middle font-mono text-xs font-normal tracking-normal whitespace-nowrap',
		// Colour and padding live in the tones only: two competing utilities would be settled by CSS order.
		tone === 'neutral' && 'border-line2 py-0.5 text-mut',
		tone === 'neutral' && (dashed ? 'px-2' : 'px-1.5'),
		tone === 'acc' && 'border-acc/45 px-2 text-acc',
		tone === 'good' && 'border-line px-2 py-0.5 text-mut',
		dashed && 'border-dashed',
		className,
	)}
>
	{tone === 'good' && <span class="size-1.5 rounded-full bg-good" aria-hidden="true" />}
	<slot />
</span>
