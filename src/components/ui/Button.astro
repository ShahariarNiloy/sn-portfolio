---
/**
 * Button — a link or a button with the site's button look.
 * `primary` is the light filled button (GitHub sign-in); `ghost` is outlined (CV, 404).
 */
import { cx } from '@/lib/cx';

export interface Props {
	variant?: 'primary' | 'ghost' | undefined;
	/** Renders an <a> when set, otherwise a <button>. */
	href?: string | undefined;
	type?: 'button' | 'submit' | undefined;
	/** Form field name and value, for submit buttons. */
	name?: string | undefined;
	value?: string | undefined;
	/** Extra attributes for islands, e.g. data-palette-open. */
	[key: `data-${string}`]: string | boolean | undefined;
	download?: boolean | undefined;
	/** Opens the link in a new tab; say so in the label. */
	target?: '_blank' | undefined;
	disabled?: boolean | undefined;
	class?: string | undefined;
}

const { variant = 'ghost', href, type = 'button', name, value, download, target, disabled, class: className, ...rest } = Astro.props;
const classes = cx(
	'inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-sm no-underline transition-colors duration-200 ease-out',
	variant === 'primary' && 'bg-fg font-medium text-bg hover:bg-head',
	variant === 'ghost' && 'border border-line2 text-fg hover:border-mut hover:bg-card',
	disabled && 'cursor-not-allowed opacity-100',
	className,
);
---

{href ? (
	<a href={href} class={classes} download={download} target={target} rel={target && 'noopener'} {...rest}>
		<slot />
	</a>
) : (
	<button type={type} name={name} value={value} class={classes} disabled={disabled} {...rest}>
		<slot />
	</button>
)}
