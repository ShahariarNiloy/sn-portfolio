---
/**
 * Home — hero, Work, Highlights, Latest posts, Stack, Career, Now and Contact.
 */
import CareerRows from '@/components/content/CareerRows.astro';
import { postDate } from '@/lib/post-dates';
import ContactLine from '@/components/content/ContactLine.astro';
import HighlightGrid from '@/components/content/HighlightGrid.astro';
import HomeIntro from '@/components/content/HomeIntro.astro';
import NowList from '@/components/content/NowList.astro';
import NumberedPosts from '@/components/content/NumberedPosts.astro';
import StackList from '@/components/content/StackList.astro';
import WorkRow from '@/components/content/WorkRow.astro';
import Link from '@/components/ui/Link.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCareer, getHomeHighlights, getLatestPosts, getNow, getProjects, getSite, getStack } from '@/lib/content';
import { formatIsoDay, formatMonth } from '@/lib/format';
import { getPersonJsonLd } from '@/lib/person';
import { buildWebSiteJsonLd } from '@/lib/seo';

const [site, projects, now, highlights, stack, posts, career] = await Promise.all([
	getSite(),
	getProjects(),
	getNow(),
	getHomeHighlights(),
	getStack(),
	getLatestPosts(4),
	getCareer(),
]);
const { home } = site;
const person = await getPersonJsonLd(Astro.site?.origin ?? 'https://shahariarniloy.com');
const more = 'mt-5 inline-flex min-h-11 items-center';
---

<BaseLayout isHome jsonLd={[buildWebSiteJsonLd(site.name, Astro.site?.href ?? '/'), person]}>
	<HomeIntro title={home.title} intro={home.intro} cta={home.cta} facts={home.facts} name={site.name} />
	<section id="work" aria-labelledby="work-h" class="section-gap">
		<SectionLabel id="work-h">Work</SectionLabel>
		<ul class="m-0 list-none p-0">
			{projects
				.filter((p) => p.data.showOnHome !== false)
				.map((p) => (
					<li>
						<WorkRow project={p} context="home" />
					</li>
				))}
		</ul>
		<p class={more}>
			<Link href="/work">All work →</Link>
		</p>
	</section>
	<section id="highlights" aria-labelledby="highlights-h" class="section-gap">
		<SectionLabel id="highlights-h">Highlights</SectionLabel>
		<HighlightGrid label="Highlights" mobileLimit={2} items={highlights} />
		<p class={more}>
			<Link href="/highlights">All highlights →</Link>
		</p>
	</section>
	<section id="blog" aria-labelledby="blog-h" class="section-gap">
		<SectionLabel id="blog-h">Latest posts</SectionLabel>
		<NumberedPosts
			mobileLimit={3}
			posts={posts.map((p) => ({ href: `/blog/${p.id}`, title: p.data.title, summary: p.data.summary, date: postDate(p.data.publishedOn) }))}
		/>
		<p class={more}>
			<Link href="/blog">All posts →</Link>
		</p>
	</section>
	<section id="stack" aria-labelledby="stack-h" class="section-gap">
		<SectionLabel id="stack-h">Stack</SectionLabel>
		<StackList items={stack} />
		<p class={more}>
			<Link href="/stack">What I use each one for →</Link>
		</p>
	</section>
	<section id="about" aria-labelledby="career-h" class="section-gap">
		<SectionLabel id="career-h">Career</SectionLabel>
		<CareerRows rows={home.experience} career={career} />
		<h3 class="mt-10 mb-4 text-base font-semibold tracking-tight text-head">Recognition</h3>
		<ul class="m-0 flex list-none flex-col gap-2.5 p-0 text-mut">
			{home.recognition.map((r) => (
				<li>
					<span class="text-fg">{r.title}</span> · {r.detail}
				</li>
			))}
		</ul>
		<p class={more}>
			<Link href="/timeline">Full timeline →</Link>
		</p>
	</section>
	<section id="now" aria-labelledby="now-h" class="section-gap">
		<SectionLabel id="now-h">Now</SectionLabel>
		<NowList lines={now.home} />
		<p class="mt-3.5 mb-0 font-mono text-meta text-mut">
			Updated <time datetime={formatIsoDay(now.updatedOn).slice(0, 7)}>{formatMonth(now.updatedOn)}</time> · <Link href="/now">More on the Now page →</Link>
		</p>
	</section>
	<section id="contact" aria-labelledby="contact-h" class="section-gap pb-6">
		<SectionLabel id="contact-h">Contact</SectionLabel>
		<ContactLine sentence={home.contact} email={site.email} github={site.github} linkedin={site.linkedin} />
		<p class="mt-10 mb-0 text-sm text-mut">
			{home.offTheClock} <Link href="/off-the-clock">Read the notes →</Link>
		</p>
	</section>
</BaseLayout>
