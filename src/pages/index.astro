	.ill .body { fill: var(--card); stroke: var(--ist); stroke-width: 1; }
	.ill .pix { fill: var(--ist2); stroke: none; }
	.ill .accfill { fill: color-mix(in srgb, var(--iacc) 32%, transparent); stroke: var(--iacc); stroke-width: 1; }
	.cap.armed .ill .drawn path { stroke-dasharray: 1; stroke-dashoffset: 1; }
	.cap.armed .ill .drawn path[class*='f-'], .cap.armed .ill .drawn path.dotf, .cap.armed .ill .drawn path.body, .cap.armed .ill .drawn path.pix, .cap.armed .ill .drawn path.accfill { fill-opacity: 0; }
	.cap.armed .ill .gfade, .cap.armed .ill .ilabs { opacity: 0; }
	.cap.armed.inview .ill .drawn path { animation: drawon 1.3s cubic-bezier(0.6, 0, 0.2, 1) forwards, fillin 0.6s ease forwards; animation-delay: var(--d), calc(var(--d) + 0.8s); }
	.cap.armed.inview .ill .gfade, .cap.armed.inview .ill .ilabs { animation: fadein2 0.8s ease 1.1s forwards; }
	.cap.inview .ill .flt { animation: bob 5s ease-in-out 2.4s infinite; }
	@keyframes drawon { to { stroke-dashoffset: 0; } }
	@keyframes fillin { to { fill-opacity: 1; } }
	@keyframes fadein2 { to { opacity: 1; } }
	@keyframes bob { 50% { transform: translateY(-8px); } }

	/* skills grid */
	.skills { position: relative; padding-top: 40px; padding-bottom: 110px; }
	.sgwrap { position: relative; width: max-content; max-width: 100%; margin: 0 auto; --mx: 50%; --my: 42%; -webkit-mask-image: radial-gradient(ellipse 62% 72% at 50% 42%, #000 52%, transparent 92%); mask-image: radial-gradient(ellipse 62% 72% at 50% 42%, #000 52%, transparent 92%); }
	.sgrid { display: grid; grid-template-columns: repeat(9, 104px); grid-auto-rows: 104px; gap: 1px; padding: 1px; background: radial-gradient(240px circle at var(--mx) var(--my), rgba(163, 165, 255, 0.6), transparent 72%), var(--line); }
	.sc { position: relative; background: var(--bg); }
	.sc.blink::after { content: ''; position: absolute; inset: 0; background: var(--accbg); opacity: 0; animation: cglow 7s ease-in-out infinite; animation-delay: inherit; }
	@keyframes cglow { 50% { opacity: 0.9; } }
	.sc.on { background: radial-gradient(120% 85% at 50% 0%, color-mix(in srgb, var(--c) 13%, transparent), transparent 62%), var(--card); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05); transition: background 0.35s; }
