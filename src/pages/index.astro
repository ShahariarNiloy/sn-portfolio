---
import Base from '../layouts/Base.astro';
import Illustration from '../components/Illustration.astro';
import { ILL } from '../lib/illustrations';
import { SITE } from '../data/site';

const prods = [
	{ key: 'adv', name: 'adventure.inc', mono: false, kind: 'Company project', title: 'Adventure Inc', desc: "My employer's travel booking platform for Japan. I work on its frontend: performance, search and SEO.", tags: ['Next.js', 'TypeScript', 'Performance'], href: '/work/adventure-inc', cta: 'Read the case study' },
	{ key: 'util', name: 'utilyx.dev', mono: true, kind: 'Product · Live', title: 'utilyx.dev', desc: '50+ developer tools that run entirely in your browser. Zero servers, nothing uploaded.', tags: ['Client-side', 'Zero server', 'Privacy'], href: SITE.utilyx, cta: 'See the project' },
	{ key: 'trw', name: 'Truly Remote Work', mono: false, kind: 'Product · Live', title: 'Truly Remote Work', desc: 'A job board for roles that are remote for real, with no hidden office days.', tags: ['Job board', 'Remote'], href: SITE.trw, cta: 'See the project' },
	{ key: 'geo', name: 'GeoRenus', mono: false, kind: 'Product · Live', title: 'GeoRenus', desc: 'A Bengali-language knowledge platform on finance, economics and business.', tags: ['Content', 'Bengali'], href: SITE.georenus, cta: 'See the project' },
	{ key: 'gal', name: 'Repo Galaxy', mono: true, kind: 'Building', title: 'Repo Galaxy', desc: 'Explore any GitHub codebase as a 3D star map, and ask AI what each part does.', tags: ['3D', 'AI', 'In progress'], href: '/work', cta: 'Follow the build' },
];

// Skills grid: 9 columns × 5 rows; keyed "col,row".
const stack: Record<string, [string, string, string, string, boolean?]> = {
	'2,0': ['Js', 'JavaScript', '#E8CB3A', 'lang'], '4,0': ['No', 'Node.js', '#6CC24A', 'runtime'], '6,0': ['S3', 'AWS S3', '#F29D38', 'cloud'],
	'1,1': ['Rs', 'Rust', '#DEA584', 'learning', true], '3,1': ['Re', 'React', '#61DAFB', 'library'], '5,1': ['Nx', 'Next.js', 'var(--fg)', 'framework'], '7,1': ['Pg', 'PostgreSQL', '#7FA7DB', 'database'],
	'2,2': ['Ts', 'TypeScript', '#5B9BEA', 'lang'], '4,2': ['Dz', 'Drizzle', '#C5F74F', 'orm'], '6,2': ['Zu', 'Zustand', '#D4A373', 'state'],
	'3,3': ['Go', 'Go', '#29BEB0', 'learning', true],
	'1,3': ['Vi', 'Vite', '#B07CFF', 'build'], '5,3': ['Tw', 'Tailwind CSS', '#38BDF8', 'css'], '7,3': ['Lh', 'Lighthouse', '#FF7A66', 'audit'],
	'8,2': ['Wa', 'WebAssembly', '#7C8CFF', 'learning', true],
	'4,4': ['Rd', 'Redis', '#FF4D4D', 'cache'], '0,2': ['Rq', 'React Query', '#F472B6', 'data'],
};
const blinks: Record<string, string> = { '0,1': '0s', '8,3': '-2s', '2,4': '-4s', '0,4': '-1s', '7,0': '-3s', '5,4': '-5s', '8,0': '-6s', '6,4': '-2.5s' };
const cells: { on: boolean; cls: string; sym?: string; name?: string; col?: string; cat?: string; dl: string }[] = [];
for (let r = 0; r < 5; r++) {
	for (let c = 0; c < 9; c++) {
		const k = `${c},${r}`;
		const s = stack[k];
		cells.push(
			s
				? { on: true, cls: 'sc on' + (s[4] ? ' lrn' : ''), sym: s[0], name: s[1], col: s[2], cat: s[3], dl: '0s' }
				: { on: false, cls: 'sc' + (blinks[k] ? ' blink' : ''), dl: blinks[k] || '0s' },
		);
	}
}
const pluses = [[2, 1], [5, 1], [7, 3], [3, 4], [6, 2]].map(([x, y]) => ({ x: 1 + x * 105, y: 1 + y * 105 }));

const log = [
	{ date: 'Nov 2026', title: 'Started Repo Galaxy', body: 'A 3D explorer for GitHub codebases, with AI answers about the code.', dot: 'var(--acc)' },
	{ date: 'Nov 2026', title: 'Redesigning utilyx.dev', body: 'A cleaner look and a new category of SEO tools on the way.', dot: 'var(--card2)' },
	{ date: 'Oct 2023', title: 'Joined Adventure Inc', body: 'Now a Senior Software Engineer on the frontend of its booking platform.', dot: 'var(--card2)' },
	{ date: '2022', title: 'Published at IEEE ICIRCA', body: 'First-author paper on Bangla handwritten character recognition.', dot: 'var(--card2)' },
	{ date: 'Feb 2022', title: 'First engineering role', body: 'Joined Sheba Technologies and built the BRAC learning management system.', dot: 'var(--card2)' },
];

const arrow = '<path d="M5 12h14M13 6l6 6-6 6"></path>';
---

<Base current="/" footer="full">
	<main>
		<section class="hero">
			<div class="gridbg" aria-hidden="true"></div>
			<div class="spot" aria-hidden="true"></div>
			<div class="wrap hero-in">
				<span class="beam rise d1">
					<a href="/work" class="beam-link"><span class="tag">New</span>Building Repo Galaxy, a 3D codebase explorer<svg width="14" height="14" viewBox="0 0 24 24" class="ico" aria-hidden="true" set:html={arrow} /></a>
				</span>
				<h1 class="h hx rise d2 hero-title"><span style="color: var(--fg)">Building software that's lighter,</span> <span class="grad">faster, and scalable.</span></h1>
				<p class="rise d3 hero-lede">I love building things and finding smarter ways to make them work. Always exploring, optimizing, and pushing the boundaries of what's possible with software.</p>
				<div class="rise d4 hero-ctas">
					<a href="/work" class="btn">View my work<svg width="14" height="14" viewBox="0 0 24 24" class="ico" aria-hidden="true" set:html={arrow} /></a>
					<a href="/about" class="btn2">About me</a>
				</div>
				<p class="mono rise d5 hero-time"><span class="dot"></span>Dhaka · <span data-dhaka-time>--:--</span> · GMT+6</p>
			</div>
		</section>

		<section aria-labelledby="show" class="wrap showcase">
			<p class="mono eyebrow center">Products I've built and worked on</p>
			<h2 id="show" class="h grad sec-title center">Five products, one obsession with speed.</h2>
			<div role="tablist" aria-label="Products" class="tabs" id="prod-tabs">
				{
					prods.map((p, i) => (
						<button type="button" role="tab" class="tb" id={`tab-${p.key}`} aria-controls={`panel-${p.key}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
							<span class="prog" aria-hidden="true" />
							<span class="tb-name" style={p.mono ? "font-family:'Geist Mono Variable',monospace" : undefined}>{p.name}</span>
							<span class="mono tb-kind">{p.kind}</span>
						</button>
					))
				}
			</div>
			<div class="card panel-card">
				{
					prods.map((p, i) => (
						<div role="tabpanel" id={`panel-${p.key}`} aria-labelledby={`tab-${p.key}`} class="panel" hidden={i !== 0}>
							<div class="pop panel-text">
								<div class="panel-copy">
									<span class="tag" style="align-self: flex-start">{p.kind}</span>
									<h3 class="h panel-title">{p.title}</h3>
									<p class="panel-desc">{p.desc}</p>
									<div class="chips">{p.tags.map((t) => <span class="chip">{t}</span>)}</div>
								</div>
								<a href={p.href} class="btn2" {...(p.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})} style="align-self: flex-start">{p.cta}<svg width="14" height="14" viewBox="0 0 24 24" class="ico" aria-hidden="true" set:html={arrow} /></a>
							</div>
							<div class="panel-vis" aria-hidden="true">
								{p.key === 'adv' && (
									<div class="pop vis-adv">
										<div class="adv-list">
											<div class="adv-row"><span class="thumb" /><span class="lines"><span style="width:70%" class="l2" /><span style="width:40%" class="l1" /></span></div>
											<div class="adv-row hot"><span class="thumb" /><span class="lines"><span style="width:60%" class="l2" /><span style="width:35%" class="l1" /></span></div>
											<div class="adv-row"><span class="thumb" /><span class="lines"><span style="width:75%" class="l2" /><span style="width:45%" class="l1" /></span></div>
										</div>
										<div class="adv-map">
											<span class="pin" style="left:28%;top:30%" />
											<span class="pin big" style="left:58%;top:46%" />
											<span class="pin" style="left:40%;top:72%" />
											<span class="pin" style="left:76%;top:20%" />
										</div>
									</div>
								)}
								{p.key === 'util' && (
									<div class="pop vis-util">
										<div class="util-search">
											<svg width="14" height="14" viewBox="0 0 24 24" class="ico" style="color: var(--mut)"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
											<span class="mono" style="color: var(--mut)">Search 50+ tools…</span>
											<span class="mono kbd">⌘K</span>
										</div>
										<div class="util-grid">
											{['{ }', 'JWT', 'B64', '.*', 'UUID', '#', 'CSV', '+43'].map((t) => (
												<span class:list={['mono', 'tool', { hot: t === 'JWT' }]}>{t}</span>
											))}
										</div>
										<div class="mono util-foot">● 0 server requests</div>
									</div>
								)}
								{p.key === 'trw' && (
									<div class="pop vis-trw">
										{[['55%', '30%', false], ['65%', '25%', true], ['48%', '34%', false]].map(([a, b, hot]) => (
											<div class:list={['job', { hot }]}>
												<span class="logo-sq" />
												<span class="lines"><span class="l2" style={`width:${a};height:7px`} /><span class="l1" style={`width:${b}`} /></span>
												<span class="mono remote">REMOTE</span>
											</div>
										))}
									</div>
								)}
								{p.key === 'geo' && (
									<div class="pop vis-geo">
										<span class="tag" style="align-self: flex-start" lang="bn">অর্থনীতি</span>
										<span lang="bn" class="geo-title">টাকা আসলে কী?</span>
										<span class="bar2" style="width:92%" />
										<span class="bar2" style="width:86%" />
										<span class="bar2" style="width:64%" />
										<span class="bar2 faint" style="width:78%" />
									</div>
								)}
								{p.key === 'gal' && (
									<div class="pop vis-gal">
										<svg viewBox="0 0 520 300" width="100%" style="display: block">
											<g style="stroke: var(--line2); stroke-width: 1">
												<line x1="90" y1="80" x2="200" y2="140" /><line x1="200" y1="140" x2="300" y2="90" /><line x1="200" y1="140" x2="260" y2="230" /><line x1="300" y1="90" x2="420" y2="130" /><line x1="260" y1="230" x2="400" y2="220" /><line x1="90" y1="80" x2="60" y2="200" /><line x1="420" y1="130" x2="400" y2="220" />
											</g>
											<circle cx="90" cy="80" r="5" style="fill: var(--mut)" /><circle cx="60" cy="200" r="4" class="twinkle" style="fill: var(--mut)" /><circle cx="300" cy="90" r="6" style="fill: var(--mut)" /><circle cx="260" cy="230" r="5" class="twinkle" style="fill: var(--mut)" /><circle cx="420" cy="130" r="4" style="fill: var(--mut)" /><circle cx="400" cy="220" r="6" class="twinkle" style="fill: var(--mut)" />
											<circle cx="200" cy="140" r="22" style="fill: var(--accbg)" /><circle cx="200" cy="140" r="9" style="fill: var(--acc)" />
											<circle cx="140" cy="40" r="1.5" class="twinkle" style="fill: var(--mut)" /><circle cx="470" cy="60" r="1.5" class="twinkle" style="fill: var(--mut)" /><circle cx="350" cy="270" r="1.5" style="fill: var(--mut)" /><circle cx="30" cy="120" r="1.5" class="twinkle" style="fill: var(--mut)" />
										</svg>
										<span class="mono gal-label">src/search</span>
										<div class="gal-ask">
											<span class="mono" style="font-size: 11px; color: var(--acc)">✦ Ask the repo</span>
											<span style="font-size: 13px; line-height: 1.5">What does src/search do?</span>
											<span class="bar2" style="width:90%;height:6px" />
											<span class="bar2" style="width:70%;height:6px" />
										</div>
									</div>
								)}
							</div>
						</div>
					))
				}
			</div>
		</section>

		<section class="wrap cap" id="cap-sec" aria-labelledby="cap">
			<p class="mono eyebrow">Capabilities</p>
			<h2 id="cap" class="h grad sec-title" style="font-size: 48px; max-width: 620px; margin-bottom: 0">Built for speed, from the first byte.</h2>
			<p class="cap-lede">I care about every kilobyte the browser downloads, and about the people who write the code.</p>

			<div class="bento">
				<div class="card bc" style="grid-column: span 4">
					<Illustration ill={ILL.perf} w={520} h={220} maxWidth="560px" labels={[{ x: 150, y: 214, text: 'before' }, { x: 370, y: 214, text: 'after' }]} />
					<div><h3>Performance is a feature</h3><p class="cd">Memory audits, code-splitting and lazy loading on a large production Next.js codebase.</p></div>
				</div>
				<div class="card bc" style="grid-column: span 2; padding: 28px; gap: 24px">
					<span class="mono" style="color: var(--mut); display: inline-flex; align-items: center; gap: 8px"><span class="dot"></span>Local time</span>
					<span class="clock" data-dhaka-time>--:--</span>
					<div><h3>Dhaka, Bangladesh</h3><p class="cd">GMT+6 · overlaps with Asia and Europe working hours.</p></div>
				</div>
				<div class="card bc" style="grid-column: span 2">
					<Illustration ill={ILL.mem} w={320} h={180} />
					<div><h3>Taming memory</h3><p class="cd">Found and fixed JavaScript heap out-of-memory issues in a large Next.js app, biggest wins first.</p></div>
				</div>
				<div class="card bc" style="grid-column: span 2">
					<Illustration ill={ILL.zero} w={320} h={180} />
					<div><h3>Zero-server tools</h3><p class="cd">utilyx.dev: 50+ developer tools that run entirely in your browser.</p></div>
				</div>
				<div class="card bc" style="grid-column: span 2">
					<Illustration ill={ILL.award} w={320} h={180} />
					<div><h3>Recognized at work</h3><p class="cd">Best Employee of the Year twice, plus Best Flexible Employee.</p></div>
				</div>
				<div class="card bc" style="grid-column: span 3">
					<Illustration ill={ILL.research} w={420} h={180} />
					<div><h3>Published research</h3><p class="cd">First-author IEEE paper on Bangla handwritten character recognition, ICIRCA 2022.</p></div>
				</div>
				<div class="card bc" style="grid-column: span 3">
					<Illustration ill={ILL.seo} w={420} h={180} />
					<div><h3>Found in every language</h3><p class="cd">Sitemaps, hreflang and structured data across a multilingual travel platform.</p></div>
				</div>
			</div>
		</section>

		<section class="skills wrap" aria-labelledby="sk">
			<p class="mono eyebrow center">Skills &amp; expertise</p>
			<h2 id="sk" class="h grad sec-title center" style="margin-bottom: 40px">The stack behind the speed.</h2>
			<p class="sr">Technologies I work with: React, Next.js, TypeScript, JavaScript, Node.js, PostgreSQL, Drizzle, Zustand, React Query, AWS S3, Vite, Tailwind CSS, Lighthouse and Redis; while learning, Go, Rust and WebAssembly.</p>
			<div class="sgwrap" id="sgwrap" aria-hidden="true">
				<div class="sgrid">
					{
						cells.map((c) => (
							<div class={c.cls} style={`--c:${c.col ?? 'transparent'};animation-delay:${c.dl}`}>
								{c.on && (
									<>
										<span class="scat">{c.cat}</span>
										<span class="sym">{c.sym}</span>
										<span class="snm">{c.name}</span>
									</>
								)}
							</div>
						))
					}
				</div>
				{
					pluses.map((p) => (
						<svg class="plus" viewBox="0 0 11 11" style={`left:${p.x}px;top:${p.y}px`}>
							<path d="M5.5 0V11M0 5.5H11" style="stroke: currentColor; stroke-width: 1; fill: none" />
						</svg>
					))
				}
			</div>
		</section>

		<section class="wrap" aria-labelledby="log" style="padding-bottom: 120px">
			<p class="mono eyebrow">Changelog</p>
			<h2 id="log" class="h grad sec-title" style="font-size: 48px">What I've been up to.</h2>
			<ol class="log">
				{
					log.map((e) => (
						<li class="log-row">
							<span class="mono" style="color: var(--mut); padding-top: 3px">{e.date}</span>
							<div class="log-rail"><span class="log-dot" style={`background:${e.dot}`} /><span class="log-line" /></div>
							<div style="padding-bottom: 36px"><p class="log-title">{e.title}</p><p class="log-body">{e.body}</p></div>
						</li>
					))
				}
			</ol>
		</section>

		<section class="wrap" style="padding-bottom: 120px">
			<div class="card cta">
				<div class="gridbg" aria-hidden="true"></div>
				<div class="spot" aria-hidden="true" style="top: -360px"></div>
				<h2 class="h grad hx cta-title">Got something that should be faster?</h2>
				<p class="cta-lede">Frontend roles, performance audits or a product that needs to feel lighter.</p>
				<div class="cta-btns"><a href="/contact" class="btn">Start a conversation</a><a href={SITE.github} class="btn2">GitHub</a></div>
			</div>
		</section>
	</main>
</Base>

<style is:global>
	/* hero */
	.hero { position: relative; overflow: hidden; }
	.hero-in { position: relative; padding-top: 104px; padding-bottom: 40px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 28px; }
	.hero-title { margin: 0; font-size: 76px; line-height: 1.02; max-width: 940px; }
	.hero-lede { margin: 0; font-size: 19px; line-height: 1.6; max-width: 620px; color: var(--mut); }
	.hero-ctas { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
	.hero-time { margin: 0; color: var(--mut); display: inline-flex; align-items: center; gap: 10px; }
	.beam { position: relative; display: inline-flex; overflow: hidden; padding: 1px; border-radius: 999px; background: var(--line); }
	.beam::before { content: ''; position: absolute; left: 50%; top: 50%; width: 400px; height: 400px; margin: -200px 0 0 -200px; background: conic-gradient(from 0deg, transparent 0deg, transparent 290deg, var(--acc) 345deg, transparent 360deg); animation: spin 4s linear infinite; }
	.beam > * { position: relative; }
	@keyframes spin { to { transform: rotate(360deg); } }
	.beam-link { display: inline-flex; align-items: center; gap: 10px; padding: 9px 16px 9px 9px; border-radius: 999px; background: var(--bg); text-decoration: none; font-size: 13px; color: var(--mut) !important; }

	.eyebrow { margin: 0 0 14px; color: var(--acc); }
	.center { text-align: center; }
	.sec-title { margin: 0 0 48px; font-size: 44px; line-height: 1.05; }
	.sec-title.center { margin-left: auto; margin-right: auto; max-width: 640px; }
	.chip { font-family: 'Geist Mono Variable', monospace; font-size: 12px; padding: 6px 10px; border-radius: 8px; border: 1px solid var(--line); color: var(--mut); }

	/* product showcase */
	.showcase { padding-top: 40px; padding-bottom: 120px; position: relative; }
	.tabs { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px; margin-bottom: 20px; }
	.tb { font: inherit; background: transparent; border: none; border-top: 1px solid var(--line); padding: 20px 4px 6px; text-align: left; cursor: pointer; color: var(--mut); position: relative; min-height: 44px; display: flex; flex-direction: column; gap: 6px; transition: color 0.3s; }
	.tb:hover, .tb[aria-selected='true'] { color: var(--fg); }
	.tb-name { font-size: 17px; font-weight: 600; letter-spacing: -0.03em; }
	.tb-kind { font-size: 11px; color: var(--mut); }
	.prog { display: none; position: absolute; left: 0; top: -1px; height: 1px; width: 100%; background: var(--fg); transform-origin: left; }
	.tb[aria-selected='true'] .prog { display: block; animation: fill 6s linear both; }
	.tabs.manual .prog { animation: none; }
	@keyframes fill { from { transform: scaleX(0); } }
	.panel-card { position: relative; overflow: hidden; box-shadow: 0 40px 120px -50px var(--glow); }
	.panel { display: flex; flex-wrap: wrap; }
	.panel[hidden] { display: none; }
	.panel-text { flex: 1 1 340px; min-width: 0; padding: 40px; display: flex; flex-direction: column; justify-content: space-between; gap: 32px; }
	.panel-copy { display: flex; flex-direction: column; gap: 14px; }
	.panel-title { margin: 0; font-size: 34px; line-height: 1.05; }
	.panel-desc { margin: 0; font-size: 16px; line-height: 1.65; color: var(--mut); }
	.chips { display: flex; flex-wrap: wrap; gap: 6px; }
	.panel-vis { flex: 1.4 1 420px; min-width: 0; min-height: 380px; border-left: 1px solid var(--line); background: var(--card2); background-image: radial-gradient(var(--line2) 1px, transparent 1px); background-size: 18px 18px; padding: 32px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; position: relative; }
	.pop { animation: pop 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
	@keyframes pop { from { opacity: 0; transform: translateY(10px) scale(0.98); filter: blur(4px); } }
	.twinkle { animation: tw 3s ease-in-out infinite; }
	@keyframes tw { 50% { opacity: 0.3; } }
	.lines { flex: 1; display: flex; flex-direction: column; gap: 6px; padding-top: 4px; }
	.lines > span { height: 6px; border-radius: 3px; display: block; }
	.l2 { background: var(--line2); }
	.l1 { background: var(--line); }
	.bar2 { display: block; height: 7px; border-radius: 4px; background: var(--line2); }
	.bar2.faint { background: var(--line); }

	.vis-adv { width: 100%; max-width: 520px; display: flex; gap: 12px; background: var(--card); border: 1px solid var(--line2); border-radius: 14px; padding: 14px; }
	.adv-list { flex: 1; display: flex; flex-direction: column; gap: 8px; }
	.adv-row { display: flex; gap: 10px; padding: 10px; border-radius: 8px; border: 1px solid var(--line); }
	.adv-row .thumb { width: 40px; height: 40px; border-radius: 6px; background: var(--line2); flex: none; }
	.adv-row.hot { border-color: var(--acc); background: var(--accbg); }
	.adv-row.hot .thumb { background: var(--acc); opacity: 0.5; }
