</style>

<script>
	import { startDhakaClock } from '../lib/clock';
	startDhakaClock();

	// Product tabs: auto-advance every 6s until the visitor picks one.
	const list = document.getElementById('prod-tabs');
	if (list) {
		const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
		let idx = 0;
		let manual = false;
		const select = (i: number, focus = false) => {
			idx = (i + tabs.length) % tabs.length;
			tabs.forEach((t, j) => {
				const on = j === idx;
				t.setAttribute('aria-selected', String(on));
				t.tabIndex = on ? 0 : -1;
				const panel = document.getElementById(t.getAttribute('aria-controls')!);
				if (panel) panel.hidden = !on;
			});
			if (focus) tabs[idx].focus();
		};
		const stopAuto = () => {
			manual = true;
			list.classList.add('manual');
		};
		tabs.forEach((t, i) =>
			t.addEventListener('click', () => {
				stopAuto();
				select(i);
			}),
		);
		list.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
				e.preventDefault();
				stopAuto();
				select(idx + (e.key === 'ArrowRight' ? 1 : -1), true);
			}
		});
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (reduce) stopAuto();
		setInterval(() => {
			if (!manual && !document.hidden) select(idx + 1);
		}, 6000);
	}

	// Capabilities: draw the illustrations when the section scrolls into view.
	const cap = document.getElementById('cap-sec');
	if (cap) {
		if (!('IntersectionObserver' in window)) {
			cap.classList.add('armed', 'inview');
		} else {
			cap.classList.add('armed');
			const io = new IntersectionObserver(
				(entries) => {
					if (entries.some((e) => e.isIntersecting)) {
						cap.classList.add('inview');
						io.disconnect();
					}
				},
				{ threshold: 0.15 },
			);
			io.observe(cap);
		}
	}

	// Skills grid spotlight follows the pointer.
	const sg = document.getElementById('sgwrap');
	if (sg) {
		sg.addEventListener('mousemove', (e) => {
			const r = sg.getBoundingClientRect();
			sg.style.setProperty('--mx', e.clientX - r.left + 'px');
			sg.style.setProperty('--my', e.clientY - r.top + 'px');
		});
		sg.addEventListener('mouseleave', () => {
			sg.style.setProperty('--mx', '50%');
			sg.style.setProperty('--my', '42%');
		});
	}
</script>
