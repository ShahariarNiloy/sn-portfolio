---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Shahariar Niloy" description="This page doesn't exist.">
	<section style="padding-top: 120px; padding-bottom: 40px">
		<div class="mono rise d1" style="color: var(--mut)">404 · 0 KB of content</div>
		<h1 class="h rise d2" style="margin: 18px 0 0; font-size: 40px; line-height: 1.1; letter-spacing: -0.04em">Nothing here.<br /><span style="color: var(--mut)">The lightest page on the site.</span></h1>
		<p class="lede rise d3" style="margin-top: 20px">This page doesn't exist, or it moved. Press <kbd class="mono" style="border: 1px solid var(--line2); border-radius: 6px; padding: 2px 6px">⌘K</kbd> to jump anywhere, or start from home.</p>
		<div class="rise d3" style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 32px">
			<a href="/" class="cvbtn">Go home</a>
			<button type="button" class="cvbtn" data-openk>Open the page menu</button>
		</div>
	</section>
</Base>
