---
/**
 * /contact — how to reach me: by email or on LinkedIn, then the rest. No form, so
 * nothing is collected or stored.
 */
import KeyValueRows from '@/components/content/KeyValueRows.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import Inline from '@/components/ui/Inline.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { getSite } from '@/lib/content';

const site = await getSite();
const rows = [
	{ label: 'Email', value: `[${site.email}](mailto:${site.email})` },
	{ label: 'LinkedIn', value: `[in/${site.linkedin.split('/').at(-1)}](${site.linkedin})` },
	{ label: 'GitHub', value: `[${site.github.split('/').at(-1)}](${site.github})` },
	{ label: 'Based in', value: `${site.location}, Bangladesh (UTC+6)` },
];
---

<PageLayout
	title="Contact"
	lede="Have something that should be faster? A role, a project, or a question about something I wrote: write to me, or find me on LinkedIn."
>
	<div slot="after-lede" class="mt-6 flex flex-wrap items-center gap-3">
		<Button variant="primary" href={`mailto:${site.email}`}>
			Write me an email
		</Button>
		<span class="text-sm text-mut">or</span>
		<Button href={site.linkedin} target="_blank">
			Let's talk on LinkedIn
			<span class="sr-only">(opens in a new tab)</span>
			<Icon name="arrow-up-right" size={14} />
		</Button>
	</div>
	<section class="pt-12">
		<KeyValueRows rows={rows} />
	</section>
	<p class="mt-8 mb-0 text-mut">
		<Inline text="Hiring? My CV is on [the timeline](/timeline). Just passing through? Leave a note in [the guestbook](/guestbook)." />
	</p>
</PageLayout>
