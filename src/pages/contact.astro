---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';

// Optional: set PUBLIC_FORM_ENDPOINT (e.g. a Formspree/Basin URL) to POST the form.
// Without it, submitting opens the visitor's mail app with the message prefilled.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';

const topics = [
	['role', 'A role'],
	['audit', 'Perf audit'],
	['build', 'A product'],
	['hi', 'Just hi'],
];
const ext = '<path d="M7 17L17 7M8 7h9v9"></path>';
---

<Base title="Contact — Shahariar Niloy" description="Frontend roles, performance audits, or a product that needs to feel lighter." current="/contact" hideCta footer="contact">
	<main class="contact">
		<div class="gridbg" aria-hidden="true"></div>
		<div class="spot" aria-hidden="true"></div>
		<div class="wrap inner">
			<div class="head">
				<p class="mono rise d1 avail"><span class="dot"></span>Available for new work</p>
				<h1 class="h grad hx rise d2" style="margin: 0; font-size: 68px; line-height: 1.02">Let's talk.</h1>
				<p class="rise d3" style="margin: 0; font-size: 18px; line-height: 1.6; max-width: 520px; color: var(--mut)">Frontend roles, performance audits, or a product that needs to feel lighter. Tell me what you're working on.</p>
			</div>

			<div class="rise d4 cols">
				<div class="card side">
					<div style="padding: 24px 20px">
						<p class="mono" style="margin: 0 0 8px; color: var(--mut)">Email</p>
						<a href={`mailto:${SITE.email}`} class="email">{SITE.email}</a>
					</div>
					<a href={SITE.github} class="li"><span><span class="li-t">GitHub</span><span class="mono" style="color: var(--mut)">@ShahariarNiloy</span></span><svg class="arr ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" set:html={ext} /></a>
					<a href={SITE.linkedin} class="li"><span><span class="li-t">LinkedIn</span><span class="mono" style="color: var(--mut)">in/shahariarniloy</span></span><svg class="arr ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" set:html={ext} /></a>
					<div class="tz"><span class="mono" style="color: var(--mut)">Dhaka · GMT+6</span><span class="mono" style="font-variant-numeric: tabular-nums" data-dhaka-time>--:--</span></div>
				</div>

				<div class="card formcard">
					<div class="pop done" id="sent" role="status" hidden>
						<span class="check"><svg width="22" height="22" viewBox="0 0 24 24" class="ico" aria-hidden="true"><path d="M5 12l5 5L20 7"></path></svg></span>
						<h2 class="h" style="margin: 0; font-size: 26px">Message sent</h2>
						<p style="margin: 0; font-size: 15px; color: var(--mut)" id="sent-msg">Thanks. I'll reply within a day.</p>
						<button type="button" class="btn2" id="again" style="margin-top: 8px">Send another</button>
					</div>
					<form id="contact-form" class="form" data-endpoint={endpoint} novalidate>
						<div>
							<span id="tp" class="lbl">What's this about?</span>
							<div class="seg topics" role="group" aria-labelledby="tp">
								{
									topics.map(([k, l], i) => (
										<button type="button" class="sb" data-topic={k} data-label={l} aria-pressed={i === 0 ? 'true' : 'false'}>
											{l}
										</button>
									))
								}
							</div>
							<input type="hidden" name="topic" value="A role" />
						</div>
						<div class="two">
							<div><label for="nm" class="lbl">Name</label><input id="nm" name="name" class="field" type="text" placeholder="Jane Doe" autocomplete="name" required /></div>
							<div><label for="em" class="lbl">Email</label><input id="em" name="email" class="field" type="email" placeholder="jane@company.com" autocomplete="email" required /></div>
						</div>
						<div><label for="msg" class="lbl">Message</label><textarea id="msg" name="message" class="field" rows="6" placeholder="A few lines about the role or project" style="resize: vertical" required></textarea></div>
						<p class="err" id="form-err" role="alert" hidden></p>
						<div class="foot-row">
							<span class="mono" style="color: var(--mut)">Replies within a day</span>
							<button type="submit" class="btn" id="send">Send message<svg width="14" height="14" viewBox="0 0 24 24" class="ico" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</main>
</Base>

<style>
	.contact {
		position: relative;
		overflow: hidden;
	}
	.inner {
		position: relative;
		padding-top: 96px;
		padding-bottom: 120px;
	}
	.head {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 18px;
		margin-bottom: 64px;
	}
	.avail {
		margin: 0;
		color: var(--mut);
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}
	.cols {
		display: flex;
		gap: 16px;
		flex-wrap: wrap;
		align-items: flex-start;
	}
	.side {
		flex: 1 1 320px;
		min-width: 0;
		overflow: hidden;
	}
	.email {
		font-size: 17px;
		font-weight: 500;
		text-decoration: none;
		word-break: break-all;
		display: inline-block;
		padding: 8px 0;
	}
	.li {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		padding: 18px 20px;
		text-decoration: none;
		border-top: 1px solid var(--line);
		transition: background-color 0.2s;
	}
	.li:hover {
		background: var(--card2);
	}
	.li-t {
		display: block;
		font-size: 15px;
		font-weight: 500;
	}
	.li .arr {
		color: var(--mut);
		transition: transform 0.3s;
	}
	.li:hover .arr {
		transform: translate(2px, -2px);
	}
	.tz {
		display: flex;
		justify-content: space-between;
		padding: 18px 20px;
		border-top: 1px solid var(--line);
	}
	.formcard {
		flex: 1.6 1 440px;
		min-width: 0;
		padding: 28px;
	}
	.form {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.form[hidden] {
		display: none;
	}
	.lbl {
		display: block;
		font-size: 13px;
		font-weight: 500;
		margin-bottom: 8px;
	}
	.topics {
		display: flex;
		background: var(--bg);
	}
	.topics .sb {
		flex: 1 1 auto;
		font-size: 13px;
		padding: 0 12px;
	}
	.two {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 16px;
	}
	.field {
		width: 100%;
		box-sizing: border-box;
		font: inherit;
		font-size: 15px;
		color: var(--fg);
		background: var(--bg);
		border: 1px solid var(--line2);
		border-radius: 10px;
		padding: 12px 14px;
		min-height: 44px;
		outline: none;
		transition: border-color 0.2s, box-shadow 0.2s;
	}
	.field:focus {
		border-color: var(--acc);
		box-shadow: 0 0 0 3px var(--accbg);
	}
	.field::placeholder {
		color: var(--mut);
	}
	.field[aria-invalid='true'] {
		border-color: #e5484d;
	}
	.err {
		margin: 0;
		font-size: 14px;
		color: #e5484d;
	}
	.foot-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
		padding-top: 4px;
	}
	.btn[disabled] {
		opacity: 0.6;
		cursor: progress;
	}
	.done {
		min-height: 420px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		gap: 14px;
	}
	.done[hidden] {
		display: none;
	}
	.check {
		width: 52px;
		height: 52px;
		border-radius: 50%;
		border: 1px solid var(--line2);
		background: var(--accbg);
		color: var(--acc);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.pop {
		animation: pop 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}
	@keyframes pop {
		from {
			opacity: 0;
			transform: scale(0.96);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.pop {
			animation: none;
		}
	}
</style>

<script>
	import { startDhakaClock } from '../lib/clock';
	startDhakaClock();

	const EMAIL = 'shahariarniloyblv@gmail.com';
	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const sent = document.getElementById('sent')!;
	const sentMsg = document.getElementById('sent-msg')!;
	const err = document.getElementById('form-err')!;
	const sendBtn = document.getElementById('send') as HTMLButtonElement;

	if (form) {
		const topicInput = form.querySelector<HTMLInputElement>('input[name="topic"]')!;
		form.querySelectorAll<HTMLButtonElement>('[data-topic]').forEach((b, _, all) => {
			b.addEventListener('click', () => {
				all.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				topicInput.value = b.dataset.label || '';
			});
		});

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			err.hidden = true;
			let firstBad: HTMLInputElement | HTMLTextAreaElement | null = null;
			form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('.field').forEach((f) => {
				const bad = !f.checkValidity() || !f.value.trim();
				f.setAttribute('aria-invalid', String(bad));
				if (bad && !firstBad) firstBad = f;
			});
			if (firstBad) {
				err.textContent = 'Please fill in your name, a valid email and a message.';
				err.hidden = false;
				(firstBad as HTMLElement).focus();
				return;
			}

			const data = new FormData(form);
			const endpoint = form.dataset.endpoint;
			if (endpoint) {
				sendBtn.disabled = true;
				try {
					const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
					if (!res.ok) throw new Error(String(res.status));
					sentMsg.textContent = "Thanks. I'll reply within a day.";
				} catch {
					err.textContent = `Couldn't send right now. Email me directly at ${EMAIL}.`;
					err.hidden = false;
					sendBtn.disabled = false;
					return;
				}
				sendBtn.disabled = false;
			} else {
				const subject = `[${data.get('topic')}] from ${data.get('name')}`;
				const body = `${data.get('message')}\n\n— ${data.get('name')} (${data.get('email')})`;
				window.location.href = `mailto:${EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
				sentMsg.textContent = "Your mail app should open with the message ready. Hit send there and I'll reply within a day.";
			}
			form.reset();
			form.hidden = true;
			sent.hidden = false;
		});

		document.getElementById('again')?.addEventListener('click', () => {
			sent.hidden = true;
			form.hidden = false;
		});
	}
</script>
