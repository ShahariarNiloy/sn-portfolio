---
/**
 * /guestbook — static page: the sign-in card and the approved notes baked in at build time from D1 (approving a note
 * triggers a rebuild).
 */
import GuestbookWall from '@/components/content/GuestbookWall.astro';
import GuestbookForm from '@/components/islands/GuestbookForm.astro';
import Link from '@/components/ui/Link.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { getApprovedNotes } from '@/lib/guestbook/approved';

const notes = await getApprovedNotes();
---

<PageLayout
	title="Guestbook"
	active="guestbook"
	lede="Say hello, leave a thought, or tell me what you took from the [notes](/off-the-clock). It stays here for whoever comes next."
>
	<h1 slot="title" class="mt-4 mb-0 text-3xl leading-tight font-semibold tracking-tight text-head sm:text-4xl">
		Guestbook. <em class="font-serif font-normal tracking-normal text-mut">Sign it.</em>
	</h1>
	<section class="pt-10">
		<GuestbookWall notes={notes}>
			<GuestbookForm />
		</GuestbookWall>
	</section>
	<p class="mt-12 mb-0 text-mut">
		The personal side lives elsewhere: <Link href="/off-the-clock">Off the clock →</Link>
	</p>
	<p class="mt-6 mb-0 font-mono text-xs text-mut">
		A guestbook, inspired by <Link href="https://leerob.com">Lee Robinson</Link>'s.
	</p>
</PageLayout>
