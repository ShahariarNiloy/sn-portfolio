---
/**
 * /uses — hardware, editor and terminal, development tools and everything else.
 */
import KeyValueRows from '@/components/content/KeyValueRows.astro';
import Inline from '@/components/ui/Inline.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { getUses } from '@/lib/content';
import { formatDay } from '@/lib/format';

const uses = await getUses();
---

<PageLayout title="Uses" lede="The hardware, software and small tools I use every day. People ask; this is the list.">
	<p slot="after-lede" class="stamp">
		Updated {formatDay(uses.updatedOn)}
	</p>
	{uses.groups.map((g) => (
		<section class="section-gap">
			<SectionLabel>{g.title}</SectionLabel>
			<KeyValueRows rows={g.rows} />
		</section>
	))}
	<p class="mt-8 mb-0 font-mono text-xs text-mut">
		<Inline text={uses.credit} />
	</p>
</PageLayout>
