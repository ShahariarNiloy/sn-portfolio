---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { SITE } from '../data/site';
import avatar from '../assets/avatar.png';

const principles = [
	['01', 'Measure first', 'No optimization without a number before and after.'],
	['02', 'Ship less', 'The fastest code is the code the browser never downloads.'],
	['03', 'Grow the team', 'Good patterns spread faster than good code reviews.'],
];
const recognition = [
	['Award', 'Best Employee of the Year', 'FY 23–24 · FY 25–26'],
	['Award', 'Best Flexible Employee (half-yearly)', 'FY 24–25'],
	['Paper', 'Bangla handwritten character recognition — first author', 'IEEE ICIRCA 2022'],
	['Certificate', 'Meta Front-End Developer Professional Certificate', 'Aug 2023'],
	['Certificate', 'IBM — Developing Front-End Apps with React', 'Mar 2023'],
	['Education', 'BSc in Computer Science & Engineering', 'Completed'],
	['Education', 'Information Technology & Business Systems, KCGI', 'In progress'],
];
---

<Base title="About — Shahariar Niloy" description="Frontend engineer in Dhaka with 4.5+ years shipping React and Next.js to production." current="/about">
	<main>
		<section class="page-hero">
			<div class="gridbg" aria-hidden="true"></div>
			<div class="spot" aria-hidden="true"></div>
			<div class="wrap hero-in">
				<div class="intro">
					<p class="mono rise d1" style="margin: 0 0 16px; color: var(--acc)">About</p>
					<h1 class="h grad hx rise d2" style="margin: 0; font-size: 64px; line-height: 1.04">I'm Niloy. I care about the kilobytes.</h1>
					<p class="rise d3" style="margin: 24px 0 0; font-size: 18px; line-height: 1.7; max-width: 600px; color: var(--mut)">I'm a frontend engineer in Dhaka with 4.5+ years of shipping React and Next.js to production. At Adventure Inc I work on the frontend of the company's travel booking platform and head the frontend department. On the side I build small, fast tools, and I'm studying Information Technology and Business Systems at KCGI.</p>
					<div class="rise d4" style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 32px"><a href="/contact" class="btn">Request my CV</a><a href={SITE.linkedin} class="btn2">LinkedIn</a></div>
				</div>
				<div class="card rise d3 portrait">
					<div class="frame"><Image src={avatar} alt="3D avatar of Shahariar Niloy" widths={[320, 388]} sizes="(max-width: 400px) 80vw, 320px" format="webp" quality={80} loading="eager" fetchpriority="high" /></div>
					<div class="cap"><span style="font-size: 14px; font-weight: 500">{SITE.fullName}</span><span class="mono loc"><span class="dot"></span>Dhaka</span></div>
				</div>
			</div>
		</section>

		<section class="wrap" aria-labelledby="pr" style="padding-bottom: 112px">
			<h2 id="pr" class="mono" style="margin: 0 0 20px; color: var(--mut); font-weight: 400">How I work</h2>
			<div class="principles">
				{
					principles.map(([n, t, d]) => (
						<div class="card" style="padding: 28px">
							<span class="tag">{n}</span>
							<h3>{t}</h3>
							<p>{d}</p>
						</div>
					))
				}
			</div>
		</section>

		<section class="wrap" aria-labelledby="exp" style="padding-bottom: 112px">
			<h2 id="exp" class="h grad sec">Experience</h2>
			<div class="row">
				<span class="mono when">Oct 2023 — Now</span>
				<div><p class="co">Adventure Inc</p><p class="role">Senior Software Engineer · Head of Department</p></div>
				<p class="what">Frontend work on the company's travel booking platform for Japan: performance, search and SEO. I also head the frontend department, about 14 engineers across Bangladesh and India. <a href="/work/adventure-inc" style="color: var(--fg)">Read the case study →</a></p>
			</div>
			<div class="row" style="border-bottom: 1px solid var(--line)">
				<span class="mono when">Feb 2022 — Oct 2023</span>
				<div><p class="co">Sheba Technologies</p><p class="role">Junior Software Engineer</p></div>
				<p class="what">Built the BRAC learning management system with React and Redux.</p>
			</div>
		</section>

		<section class="wrap" aria-labelledby="rec" style="padding-bottom: 120px">
			<h2 id="rec" class="h grad sec">Recognition &amp; learning</h2>
			<ul class="recs">
				{
					recognition.map(([k, t, w]) => (
						<li class="rec">
							<span class="tag" style="justify-self: start">{k}</span>
							<span style="font-size: 15px; font-weight: 500">{t}</span>
							<span class="mono" style="color: var(--mut)">{w}</span>
						</li>
					))
				}
			</ul>
		</section>
	</main>
</Base>

<style>
	.page-hero {
		position: relative;
		overflow: hidden;
	}
	.hero-in {
		position: relative;
		padding-top: 96px;
		padding-bottom: 96px;
		display: flex;
		gap: 56px;
		align-items: center;
		flex-wrap: wrap;
	}
	.intro {
		flex: 999 1 520px;
		min-width: 0;
	}
	.portrait {
		flex: 1 1 300px;
		max-width: 360px;
		aspect-ratio: 4 / 5;
		padding: 10px;
		display: flex;
		flex-direction: column;
	}
	.frame {
		flex: 1;
		min-height: 0;
		border-radius: 10px;
		overflow: hidden;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		background: radial-gradient(120% 80% at 50% 0%, var(--accbg), transparent 62%), var(--card2);
	}
	.frame img {
		width: 88%;
		height: auto;
		max-height: 100%;
		object-fit: contain;
		object-position: bottom;
		display: block;
	}
	.cap {
		padding: 14px 8px 6px;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.loc {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--mut);
	}
	.principles {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 12px;
	}
	.principles h3 {
		margin: 18px 0 8px;
		font-size: 18px;
		font-weight: 600;
		letter-spacing: -0.02em;
	}
	.principles p {
		margin: 0;
		font-size: 15px;
		line-height: 1.6;
		color: var(--mut);
	}
	.sec {
		margin: 0 0 32px;
		font-size: 40px;
		line-height: 1.1;
	}
	.row {
		display: grid;
		grid-template-columns: 180px minmax(0, 1fr) minmax(0, 1.3fr);
		gap: 24px;
		padding: 24px 4px;
		border-top: 1px solid var(--line);
		transition: background-color 0.3s;
	}
	.row:hover {
		background: var(--card);
	}
	.when {
		color: var(--mut);
		padding-top: 3px;
	}
	.co {
		margin: 0;
		font-size: 16px;
		font-weight: 600;
	}
	.role {
		margin: 4px 0 0;
		font-size: 14px;
		color: var(--mut);
	}
	.what {
		margin: 0;
		font-size: 15px;
		line-height: 1.65;
		color: var(--mut);
	}
	.recs {
		list-style: none;
		margin: 0;
		padding: 0;
		border-bottom: 1px solid var(--line);
	}
	.rec {
		display: grid;
		grid-template-columns: 130px minmax(0, 1fr) auto;
		gap: 20px;
		align-items: center;
		padding: 18px 4px;
		border-top: 1px solid var(--line);
	}
	@media (max-width: 860px) {
		.row {
			grid-template-columns: minmax(0, 1fr);
			gap: 6px;
		}
		.rec {
			grid-template-columns: minmax(0, 1fr);
			gap: 8px;
		}
	}
</style>
