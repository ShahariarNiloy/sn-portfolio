---
/**
 * /off-the-clock/[slug] — one essay on its own page, serif title, for sharing.
 * Not in the mockup; follows the post layout without an illustration.
 */
import { render } from 'astro:content';

import NextLink from '@/components/content/NextLink.astro';
import DayStamp from '@/components/ui/DayStamp.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { getEssays, getNext, getSite } from '@/lib/content';
import { shareImageUrl } from '@/lib/og';
import { buildPostingJsonLd } from '@/lib/seo';

export async function getStaticPaths() {
	const essays = await getEssays();
	return essays.map((essay) => ({ params: { slug: essay.id }, props: { essay, next: getNext(essays, essay.id) } }));
}

const { essay, next } = Astro.props;
const { Content } = await render(essay);
const site = await getSite();
const origin = Astro.site?.origin ?? 'https://shahariarniloy.com';
const jsonLd = [
	buildPostingJsonLd({
		title: essay.data.title,
		summary: essay.data.excerpt.replace(/\s+/g, ' '),
		url: new URL(Astro.url.pathname, origin).href,
		publishedOn: essay.data.publishedOn,
		authorName: site.name,
		authorUrl: new URL('/', origin).href,
		image: shareImageUrl(Astro.url.pathname, origin),
	}),
];
---

<PageLayout
	title={essay.data.title}
	description={essay.data.excerpt}
	trail={[{ label: 'Off the clock', href: '/off-the-clock' }]}
	ogType="article"
	jsonLd={jsonLd}
	isArticle
>
	<h1 slot="title" class="mt-4 mb-0 font-serif text-4xl leading-tight font-normal text-head sm:text-5xl">
		{essay.data.title}
	</h1>
	<p slot="after-lede" class="mt-4 mb-0">
		<DayStamp date={essay.data.publishedOn} />
	</p>
	<div class="essay pt-12">
		<Content />
		<p class="mt-5 text-lg" aria-label="Signed with a peace sign">
			✌️
		</p>
	</div>
	{next && (
		<section slot="after" class="pt-16">
			<NextLink href={`/off-the-clock/${next.id}`} kicker="Next essay" title={next.data.title} />
		</section>
	)}
</PageLayout>
