---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Meta from '../../components/Meta.astro';
import NextCard from '../../components/NextCard.astro';
---

<Base title="Truly Remote Work — Shahariar Niloy" description="A job board for roles that are remote for real, anywhere in the world." current="/work">
	<PageHead
		title="Truly Remote Work"
		trail={[{ href: '/work', label: 'Work' }]}
		lede="A job board that lists only roles you can do from anywhere in the world — no hidden office days and no &ldquo;remote, but only in one country&rdquo;."
	/>
	<Meta
		items={[
			['Type', 'Personal product'],
			['Role', 'Founder, design and engineering'],
			['Stack', 'Astro and Go'],
			['Link', '<a href="https://trulyremotework.com/" class="ilink" target="_blank" rel="noopener">trulyremotework.com</a>'],
		]}
	/>
	<section style="padding-top: 64px">
		<h2 class="lbl">Traction</h2>
		<div class="stat">
			<div><span class="n">18K+</span><span class="l">monthly active users</span></div>
			<div><span class="n">~100K</span><span class="l">monthly pageviews</span></div>
			<div><span class="n">210K+</span><span class="l">impressions on one LinkedIn post</span></div>
		</div>
		<p class="mono" style="margin: 12px 0 0; color: var(--mut)">As of Sep 2026</p>
	</section>
	<section style="padding-top: 64px">
		<h2 class="lbl">What I did</h2>
		<ul class="bl">
			<li><span><b>Built it end to end</b> with Astro on the front and Go behind it.</span></li>
			<li><span><b>Strict listings.</b> Every role is location-free, so the board means what its name says.</span></li>
			<li><span><b>Grew it without ads</b>, through LinkedIn and Facebook posts that list companies hiring remotely.</span></li>
		</ul>
	</section>
	<section style="padding-top: 64px">
		<h2 class="lbl">Screens</h2>
		<div class="shot"><div><span class="mono" style="color: var(--mut)">[SCREENSHOT — job listings]</span></div></div>
	</section>
	<NextCard href="/work/georenus" kicker="Next project" title="GeoRenus" />
</Base>
