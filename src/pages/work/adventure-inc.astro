---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Meta from '../../components/Meta.astro';
import NextCard from '../../components/NextCard.astro';
---

<Base title="Adventure Inc — Shahariar Niloy" description="Frontend work on a travel booking platform in 84+ locales: memory, performance, SEO and search." current="/work">
	<PageHead
		title="Adventure Inc"
		pill="Company project"
		trail={[{ href: '/work', label: 'Work' }]}
		lede="A travel booking platform for flights, hotels, vacation rentals and tours in Japan, serving 84+ locales. It's my employer's product, built by a whole team. This page covers the parts I owned or drove."
	/>
	<Meta
		items={[
			['Company', 'Adventure Dhaka Limited'],
			['Role', 'Senior Software Engineer'],
			['Period', 'Oct 2023 — present'],
			['Link', '<a href="https://adventure.inc" class="ilink" target="_blank" rel="noopener">adventure.inc</a>'],
		]}
	/>
	<section style="padding-top: 64px">
		<h2 class="lbl">Stack</h2>
		<p style="margin: 0; color: var(--mut)">Next.js, React, TypeScript, tRPC, TanStack Query, Zustand and Tailwind CSS, on AWS behind a CDN.</p>
	</section>
	<section style="padding-top: 64px">
		<h2 class="lbl">What I worked on</h2>
		<ul class="bl">
			<li><span><b>Memory and stability.</b> A prioritized audit of JavaScript heap out-of-memory crashes, fixed in order of impact. <a href="/highlights/taming-memory" class="ilink">Read more</a></span></li>
			<li><span><b>Performance.</b> Lighthouse audits, lower Total Blocking Time and better Core Web Vitals. <a href="/highlights/performance" class="ilink">Read more</a></span></li>
			<li><span><b>SEO across 84+ locales.</b> Sitemaps, hreflang and structured data. <a href="/highlights/seo" class="ilink">Read more</a></span></li>
			<li><span><b>Search.</b> A shared search module with per-product adapters: infinite scroll, list virtualization, map markers and batched mobile filters.</span></li>
			<li><span><b>One property module.</b> Merged separate hotel and vacation-rental code paths into a single property module.</span></li>
			<li><span><b>Flights.</b> URL architecture for one-way and round-trip routes, and constant-time filter indexing on results.</span></li>
			<li><span><b>Design system.</b> An accessibility audit covering color contrast, touch targets and reduced motion, plus refactors of core components.</span></li>
		</ul>
	</section>
	<section style="padding-top: 64px">
		<h2 class="lbl">Screens</h2>
		<div class="shot"><div><span class="mono" style="color: var(--mut)">[SCREENSHOT — search results with map]</span></div></div>
		<div class="shot"><div><span class="mono" style="color: var(--mut)">[SCREENSHOT — property page]</span></div></div>
	</section>
	<section style="padding-top: 64px">
		<h2 class="lbl">Results</h2>
		<div class="stat">
			<div><span class="n">[X]%</span><span class="l">[METRIC — e.g. lower TBT]</span></div>
			<div><span class="n">[X]</span><span class="l">[METRIC — e.g. fewer OOM restarts]</span></div>
			<div><span class="n">84+</span><span class="l">locales served</span></div>
		</div>
	</section>
	<NextCard href="/work/utilyx" kicker="Next project" title="utilyx.dev" />
</Base>
