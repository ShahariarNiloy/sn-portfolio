---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Meta from '../../components/Meta.astro';
import NextCard from '../../components/NextCard.astro';
---

<Base title="Repo Galaxy — Shahariar Niloy" description="Explore any GitHub codebase as a 3D star map and ask an AI what any part of it does." current="/work">
	<PageHead
		title="Repo Galaxy"
		pill="In progress"
		trail={[{ href: '/work', label: 'Work' }]}
		lede="Explore any GitHub codebase as a 3D star map — folders as clusters, files as stars — and ask an AI what any part of it does."
	/>
	<Meta
		items={[
			['Type', 'Personal product'],
			['Status', 'Building'],
			['Started', '2026'],
			['Link', '[COMING SOON]'],
		]}
	/>
	<section style="padding-top: 64px">
		<h2 class="lbl">Why</h2>
		<div class="prose"><p>Opening a new codebase is like arriving in a city without a map. Repo Galaxy turns the structure into something you can <strong>see and fly through</strong>, then answers questions about what you are looking at.</p></div>
	</section>
	<section style="padding-top: 64px">
		<h2 class="lbl">Planned</h2>
		<ul class="bl">
			<li><span>Paste a GitHub URL and see the repository as a 3D galaxy.</span></li>
			<li><span>Click any file or folder and ask the AI what it does.</span></li>
			<li><span>Keep it light: fast to load, even on large repositories.</span></li>
		</ul>
	</section>
	<section style="padding-top: 64px">
		<h2 class="lbl">Progress</h2>
		<div class="note">[ADD BUILD NOTES OR SCREENSHOTS AS IT TAKES SHAPE]</div>
	</section>
	<NextCard href="/work/adventure-inc" kicker="Back to the start" title="Adventure Inc" />
</Base>
