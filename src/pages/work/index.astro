---
/**
 * /work — every project, grouped: Company, Products, Building.
 */
import WorkRow from '@/components/content/WorkRow.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { getProjects } from '@/lib/content';

const projects = await getProjects();
const GROUPS = [
	{ id: 'company', label: 'Company' },
	{ id: 'product', label: 'Products' },
	{ id: 'building', label: 'Building' },
] as const;
---

<PageLayout
	title="Work"
	active="work"
	lede="One company platform I help build, one product of my own, two I co-build, and one I'm building now. Each has its own page with the details."
>
	{GROUPS.map((g, i) => (
		<section class={i === 0 ? 'pt-16' : 'pt-12'}>
			<SectionLabel>{g.label}</SectionLabel>
			{projects
				.filter((p) => p.data.group === g.id)
				.map((p) => (
					<WorkRow project={p} context="work" />
				))}
		</section>
	))}
</PageLayout>
