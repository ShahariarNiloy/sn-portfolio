---
import Base from '../../layouts/Base.astro';
import { PROJECTS } from '../../data/site';

const filters = [
	{ key: 'all', label: 'All', n: PROJECTS.length },
	{ key: 'pro', label: 'Company', n: PROJECTS.filter((p) => p.tag === 'pro').length },
	{ key: 'product', label: 'Products', n: PROJECTS.filter((p) => p.tag === 'product').length },
	{ key: 'wip', label: 'Building', n: PROJECTS.filter((p) => p.tag === 'wip').length },
];
---

<Base title="Work — Shahariar Niloy" description="Products, platforms and experiments by Shahariar Niloy." current="/work">
	<main>
		<section class="page-hero">
			<div class="gridbg" aria-hidden="true"></div>
			<div class="spot" aria-hidden="true"></div>
			<div class="wrap hero-in">
				<p class="mono rise d1" style="margin: 0 0 16px; color: var(--acc)">Work · {PROJECTS.length} projects</p>
				<h1 class="h grad hx rise d2" style="margin: 0; font-size: 68px; line-height: 1.02; max-width: 760px">Products, platforms and experiments.</h1>
				<p class="rise d3" style="margin: 20px 0 0; font-size: 18px; line-height: 1.6; max-width: 580px; color: var(--mut)">One company project from my day job, three products I built on my own, and two I'm building now. The common thread: fast and light.</p>
			</div>
		</section>

		<section class="wrap" aria-label="Projects" style="padding-bottom: 120px">
			<div class="seg" role="group" aria-label="Filter projects" id="filters" style="margin-bottom: 28px">
				{
					filters.map((f) => (
						<button type="button" class="sb" data-filter={f.key} aria-pressed={f.key === 'all' ? 'true' : 'false'}>
							{f.label} <span class="mono" style="opacity: .7; margin-left: 4px">{f.n}</span>
						</button>
					))
				}
			</div>
			<div class="grid" id="projects">
				{
					PROJECTS.map((p) => {
						const Tag = p.href ? 'a' : 'div';
						const external = p.href?.startsWith('http');
						return (
							<Tag
								href={p.href}
								class:list={['card', 'wk', { link: !!p.href }]}
								data-tag={p.tag}
								{...(external ? { target: '_blank', rel: 'noopener' } : {})}
							>
								<div class="thumb">
									<div class="pv">
										<span class="mark" style={`font-size:${p.size};font-family:${p.mono ? "'Geist Mono Variable', monospace" : "'Geist Variable', sans-serif"}`}>{p.mark}</span>
									</div>
								</div>
								<div class="meta">
									<div class="row">
										<h2>{p.name}</h2>
										<span class="mono status"><span class="dot" style={`background:${p.dot}`} />{p.status}</span>
									</div>
									<p class="desc">{p.desc}</p>
									<span class="mono" style="color: var(--mut)">{p.stack}</span>
								</div>
							</Tag>
						);
					})
				}
			</div>
		</section>
	</main>
</Base>

<style>
	.page-hero {
		position: relative;
		overflow: hidden;
	}
	.hero-in {
		position: relative;
		padding-top: 96px;
		padding-bottom: 56px;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(330px, 100%), 1fr));
		gap: 12px;
	}
	.wk {
		padding: 10px;
		animation: rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}
	.wk[hidden] {
		display: none;
	}
	.thumb {
		border-radius: 10px;
		overflow: hidden;
		border: 1px solid var(--line);
		aspect-ratio: 16 / 11;
		background: var(--card2);
		position: relative;
	}
	.pv {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		background-image: radial-gradient(var(--line2) 1px, transparent 1px);
		background-size: 16px 16px;
		transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.link:hover .pv {
		transform: scale(1.04);
	}
	.mark {
		font-weight: 600;
		letter-spacing: -0.05em;
		padding: 14px 22px;
		border-radius: 14px;
		background: var(--card);
		border: 1px solid var(--line2);
	}
	.meta {
		padding: 18px 10px 10px;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px;
	}
	h2 {
		margin: 0;
		font-size: 17px;
		font-weight: 600;
		letter-spacing: -0.02em;
	}
	.status {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--mut);
		white-space: nowrap;
	}
	.desc {
		margin: 0;
		font-size: 14px;
		line-height: 1.55;
		color: var(--mut);
	}
	@media (prefers-reduced-motion: reduce) {
		.wk {
			animation: none;
		}
	}
</style>

<script>
	const group = document.getElementById('filters');
	const cards = Array.from(document.querySelectorAll<HTMLElement>('#projects [data-tag]'));
	group?.addEventListener('click', (e) => {
		const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
		if (!btn) return;
		const f = btn.dataset.filter;
		group.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
		cards.forEach((c) => {
			c.hidden = !(f === 'all' || c.dataset.tag === f);
		});
	});
</script>
