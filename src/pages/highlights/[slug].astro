---
/**
 * /highlights/[slug] — one case study: title, lede, illustration, MDX body and
 * the next highlight.
 */
import { render } from 'astro:content';

import { MDX_COMPONENTS } from '@/components/content/mdx';
import PostLayout from '@/layouts/PostLayout.astro';
import { getHighlights, getNext, getSite } from '@/lib/content';
import { shareImageUrl } from '@/lib/og';
import { buildPostingJsonLd } from '@/lib/seo';

export async function getStaticPaths() {
	const highlights = await getHighlights();
	return highlights.map((highlight) => ({ params: { slug: highlight.id }, props: { highlight, next: getNext(highlights, highlight.id) } }));
}

const { highlight, next } = Astro.props;
const { Content } = await render(highlight);
const site = await getSite();
const origin = Astro.site?.origin ?? 'https://shahariarniloy.com';
const url = new URL(Astro.url.pathname, origin).href;
const author = { authorName: site.name, authorUrl: new URL('/', origin).href, image: shareImageUrl(Astro.url.pathname, origin) };
const { paper } = highlight.data;
const jsonLd = [
	buildPostingJsonLd({ type: 'Article', title: highlight.data.title, summary: highlight.data.lede, url, ...author }),
	...(paper
		? [
				buildPostingJsonLd({
					type: 'ScholarlyArticle',
					title: paper.title,
					summary: highlight.data.lede,
					url: paper.url,
					publishedOn: paper.publishedOn,
					...author,
					extra: {
						sameAs: `https://doi.org/${paper.doi}`,
						identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: paper.doi },
						isPartOf: { '@type': 'PublicationEvent', name: paper.venue },
						publisher: { '@type': 'Organization', name: 'IEEE' },
					},
				}),
			]
		: []),
];
---

<PostLayout
	variant="case"
	title={highlight.data.title}
	lede={highlight.data.lede}
	trail={[{ label: 'Highlights', href: '/highlights' }]}
	illustration={highlight.data.illustration}
	jsonLd={jsonLd}
	next={next && { href: `/highlights/${next.id}`, kicker: 'Next highlight', title: next.data.title }}
>
	<Content components={MDX_COMPONENTS} />
</PostLayout>
