---
/**
 * /now — what I'm focused on: updated date, then Work, Building, Learning,
 * Writing, Collecting and Life.
 */
import KeyValueRows from '@/components/content/KeyValueRows.astro';
import Link from '@/components/ui/Link.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { getNow } from '@/lib/content';
import { formatDay } from '@/lib/format';

const now = await getNow();
---

<PageLayout title="Now" lede="What I'm focused on at this point in my life. If we haven't talked in a while, start here.">
	<p slot="after-lede" class="stamp">
		Updated {formatDay(now.updatedOn)} · {now.place}
	</p>
	<section class="pt-12">
		<KeyValueRows rows={now.items.map((i) => ({ label: i.label, value: i.body }))} />
	</section>
	<p class="mt-8 mb-0 font-mono text-xs text-mut">
		A <Link href="https://nownownow.com/about">now page</Link>, an idea from Derek Sivers.
	</p>
</PageLayout>
