---
/**
 * /timeline — the CV (view or download), the Career card and the year-by-year timeline.
 */
import CareerCard from '@/components/content/CareerCard.astro';
import Timeline from '@/components/content/Timeline.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { getCareer, getTimeline } from '@/lib/content';

const [years, career] = await Promise.all([getTimeline(), getCareer()]);
// The file in public/. Replace it under the same name to update the CV.
const CV_URL = '/shahariar-niloy-cv.pdf';
---

<PageLayout title="Timeline" active="timeline" lede="Newest first: roles, research, recognition and the steps in between.">
	<div slot="after-lede" class="mt-6 flex flex-wrap gap-2.5">
		<Button href={CV_URL} target="_blank">
			View CV
			<Icon name="arrow-up-right" size={14} />
			<span class="sr-only">(PDF, opens in a new tab)</span>
		</Button>
		<Button href={CV_URL} download>
			<Icon name="download" size={14} />
			<span>
				Download CV<span class="sr-only"> (PDF)</span>
			</span>
		</Button>
	</div>
	<section class="section-gap" aria-labelledby="career-h">
		<SectionLabel id="career-h">Career</SectionLabel>
		<CareerCard companies={career} />
	</section>
	<section class="section-gap">
		<SectionLabel>Year by year</SectionLabel>
		<Timeline years={years} />
	</section>
</PageLayout>
