{
	"ci": {
		"collect": {
			"numberOfRuns": 3,
			"url": [
				"http://localhost:4330/",
				"http://localhost:4330/work",
				"http://localhost:4330/work/utilyx",
				"http://localhost:4330/highlights/performance",
				"http://localhost:4330/blog",
				"http://localhost:4330/blog/memory-limit",
				"http://localhost:4330/stack",
				"http://localhost:4330/timeline",
				"http://localhost:4330/off-the-clock",
				"http://localhost:4330/now",
				"http://localhost:4330/uses",
				"http://localhost:4330/guestbook"
			],
			"settings": {
				"formFactor": "mobile",
				"throttlingMethod": "simulate"
			},
			"startServerCommand": "pnpm astro preview --port 4330",
			"startServerReadyPattern": "localhost:4330"
		},
		"assert": {
			"aggregationMethod": "median",
			"assertions": {
				"categories:performance": [
					"error",
					{
						"minScore": 0.95
					}
				],
				"categories:accessibility": [
					"error",
					{
						"minScore": 1
					}
				],
				"categories:best-practices": [
					"error",
					{
						"minScore": 1
					}
				],
				"categories:seo": [
					"error",
					{
						"minScore": 1
					}
				],
				"largest-contentful-paint": [
					"error",
					{
						"maxNumericValue": 2000
					}
				],
				"cumulative-layout-shift": [
					"error",
					{
						"maxNumericValue": 0.02
					}
				],
				"total-blocking-time": [
					"error",
					{
						"maxNumericValue": 50
					}
				]
			}
		},
		"upload": {
			"target": "temporary-public-storage"
		}
	}
}
