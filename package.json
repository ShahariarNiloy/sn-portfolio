{
	"name": "shahariarniloy",
	"description": "Portfolio of Shahariar Niloy, built with Astro.",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.21.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"check": "astro check && tsc --noEmit",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"e2e": "playwright test",
		"lhci": "lhci autorun",
		"og": "node scripts/og-images.mjs",
		"db:migrate:local": "wrangler d1 migrations apply guestbook --local",
		"db:migrate:remote": "wrangler d1 migrations apply guestbook --remote",
		"guestbook:pull": "mkdir -p .wrangler && wrangler d1 export guestbook --remote --table notes --output .wrangler/notes.sql && wrangler d1 execute guestbook --local --file .wrangler/notes.sql"
	},
	"dependencies": {
		"@astrojs/cloudflare": "14.4.9",
		"@astrojs/mdx": "8.1.6",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.6",
		"@fontsource/geist": "5.3.0",
		"@fontsource/geist-mono": "5.3.0",
		"@fontsource/instrument-serif": "5.3.0",
		"@tailwindcss/vite": "4.3.5",
		"astro": "7.4.13",
		"tailwindcss": "4.3.5"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@axe-core/playwright": "4.14.0",
		"@cloudflare/workers-types": "5.20261124.1",
		"@eslint/js": "10.0.1",
		"@lhci/cli": "0.16.1",
		"@playwright/test": "1.65.1",
		"eslint": "10.15.0",
		"eslint-plugin-astro": "3.2.1",
		"globals": "17.14.0",
		"prettier": "3.10.1",
		"prettier-plugin-astro": "1.1.2",
		"prettier-plugin-tailwindcss": "0.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.74.0",
		"vitest": "5.1.1",
		"wrangler": "4.167.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"workerd",
			"sharp"
		]
	}
}
