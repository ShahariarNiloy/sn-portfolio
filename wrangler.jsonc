// Cloudflare Workers config: static assets from the edge, plus the Guestbook's
// D1 database and the R2 bucket that holds the CV PDF.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shahariarniloy",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		// Pages build as /page/index.html; serve them at /page, matching trailingSlash: "never".
		"html_handling": "drop-trailing-slash",
		// Browser navigations skip the Worker unless a path is listed here, so sign-in links would get the 404 page.
		"run_worker_first": ["/api/*", "/guestbook/admin"],
	},
	"routes": [
		{
			"pattern": "shahariarniloy.com",
			"custom_domain": true,
		},
		{
			"pattern": "www.shahariarniloy.com",
			"custom_domain": true,
		},
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "guestbook",
			"database_id": "cc2dff11-230b-4bdf-9776-b9145c13b8dd",
			"migrations_dir": "db/migrations",
		},
	],
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "shahariarniloy-files" }],
}
